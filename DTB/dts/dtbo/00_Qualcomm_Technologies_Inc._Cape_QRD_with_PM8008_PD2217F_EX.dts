						qcom,wf-fifo-period = <0x0a>;
						qcom,wf-brake-pattern = [00 00 00];
						qcom,wf-brake-disable;
						qcom,wf-auto-res-disable;
					};

					effect_2 {
						qcom,wf-vmax-mv = <0x1f40>;
						qcom,wf-pattern-period-us = <0x16fa>;
						qcom,effect-id = <0x02>;
						qcom,wf-fifo-data = <0x50b11 0x161c2127 0x2c31373c 0x41454a4f 0x53575b5f 0x63666a6d 0x70727577 0x797b7c7d 0x7e7f7f7f 0x7f7f7f7e 0x7d7b7a78 0x7674716f 0x6c686561 0x5e5a5651 0x4d48443f 0x3a342f2a 0x241f1914 0xe0903fe 0xf8f3ede8 0xe2dcd7d2 0xccc7c2bd 0xb9b4afab 0xa7a39f9c 0x9895928f 0x8d8a8886 0x85848282 0x81818181 0x81828384 0x8587898b 0x8d909396 0x999ca0a4 0xa8acb0b5 0xbabec3c8 0xced3d8de 0xe3e9eef4 0xfa00fcf7 0xf2ede8e4 0xdfdbd6d2 0xcdc9c5c1 0xbdb9b6b2 0xafaca9a6 0xa4a19f9d 0x9b999897 0x96959494 0x94949494 0x95969799 0x9a9c9ea0 0xa2a5a7aa 0xadb0b4b7 0xbbbfc3c7 0xcbcfd3d8 0xdce1e6ea 0xeff4f9fe 0x1060b10 0x15191e23 0x272c3034 0x393d4144 0x484c4f52 0x55585b5d 0x60626466 0x67696a6b 0x6b6c6c6c 0x6c6c6b6a 0x69686765 0x63615f5d 0x5a585551 0x4e4b4744 0x403c3833 0x2f2b2622 0x1d18140f 0xa050000 0x00>;
						qcom,wf-fifo-period = <0x0a>;
						qcom,wf-brake-pattern = [00 00 00];
						qcom,wf-brake-disable;
