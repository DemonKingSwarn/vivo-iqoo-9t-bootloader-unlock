				phandle = <0x16c>;
				#clock-cells = <0x01>;
				qcom,codec-lpass-clk-id = <0x316>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-ext-clk-src = <0x0f>;
				compatible = "qcom,audio-ref-clk";
				status = "disabled";
			};

			clock_audio_rx_mclk2_2x_clk: rx_mclk2_2x_clk {
				phandle = <0xaf>;
				#clock-cells = <0x01>;
				qcom,codec-lpass-clk-id = <0x318>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-ext-clk-src = <0x10>;
				compatible = "qcom,audio-ref-clk";
			};
		};
	};

	fragment@97 {
		target = <&tlmm>;

		__overlay__ {

			max20328_gpio_default: max20328_gpio_default {
				phandle = <0xec>;

				mux {
					function = "gpio";
					pins = "gpio159", "gpio71";
				};

				config {
					bias-disable;
					drive-strength = <0x02>;
					pins = "gpio159", "gpio71";
				};
			};

			smartpa_l_gpio_default: smartpa_l_gpio_default {
				phandle = <0xe9>;

				mux {
					function = "gpio";
					pins = "gpio182";
				};

				config {
					bias-disable;
					drive-strength = <0x02>;
					pins = "gpio182";
				};
			};

			smartpa_r_gpio_default: smartpa_r_gpio_default {
				phandle = <0xea>;

				mux {
					function = "gpio";
					pins = "gpio116";
				};

				config {
					bias-disable;
					drive-strength = <0x02>;
					pins = "gpio116";
				};
			};
		};
	};

	fragment@98 {
		target = <&wcd938x_reset_active>;

		__overlay__ {

			config {
				drive-strength = <0x08>;
			};
		};
	};

	fragment@99 {
		target = <&wcd938x_reset_sleep>;

		__overlay__ {

			config {
				drive-strength = <0x08>;
			};
		};
	};

	fragment@100 {
		target = <&spf_core_platform>;

		__overlay__ {

			cdc_pri_mi2s_gpios: msm_cdc_pinctrl_pri {
				phandle = <0x16d>;
				#gpio-cells = <0x00>;
				pinctrl-1 = <&pri_mi2s_sck_sleep>, <&pri_mi2s_ws_sleep>, <&pri_mi2s_sd0_sleep>;
				pinctrl-0 = <&pri_mi2s_sck_active>, <&pri_mi2s_ws_active>, <&pri_mi2s_sd0_active>;
				pinctrl-names = "aud_active", "aud_sleep";
				compatible = "qcom,msm-cdc-pinctrl";
			};

			cdc_quin_mi2s_gpios: msm_cdc_pinctrl_quin {
				phandle = <0xba>;
				#gpio-cells = <0x00>;
				qcom,tlmm-pins = <0xab 0xac 0xae>;
				qcom,lpi-gpios;
				pinctrl-1 = <&lpi_i2s1_sck_sleep>, <&lpi_i2s1_ws_sleep>, <&lpi_i2s1_sd0_sleep>, <&lpi_i2s1_sd1_sleep>;
				pinctrl-0 = <&lpi_i2s1_sck_active>, <&lpi_i2s1_ws_active>, <&lpi_i2s1_sd0_active>, <&lpi_i2s1_sd1_active>;
				pinctrl-names = "aud_active", "aud_sleep";
				compatible = "qcom,msm-cdc-pinctrl";
			};
		};
	};

	fragment@101 {
		target = <&soc>;

		__overlay__ {

			clock_audio_sec: clock_audio_sec {
				phandle = <0xeb>;
				#clock-cells = <0x01>;
				pinctrl-1 = <&sec_mi2s_mclk_sleep>;
				pinctrl-0 = <&sec_mi2s_mclk_active>;
				pinctrl-names = "active", "sleep";
				qcom,use-pinctrl = <0x01>;
				qcom,codec-lpass-clk-id = <0x301>;
				qcom,codec-lpass-ext-clk-freq = <0x124f800>;
				qcom,codec-ext-clk-src = <0x03>;
				compatible = "qcom,audio-ref-clk";
				status = "disabled";
			};

			vivo-codec-common {
				pinctrl-0 = <&smartpa_l_gpio_default>, <&smartpa_r_gpio_default>;
				pinctrl-names = "default";
				compatible = "vivo,vivo-codec-common";
			};

			hifi_1v8: hifi_1v8@0 {
				phandle = <0x16e>;
				enable-active-high;
				startup-delay-us = <0x3e8>;
				gpio = <&tlmm>, <0x80 0x00>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-min-microvolt = <0x1b7740>;
				regulator-name = "hifi_1v8";
				compatible = "regulator-fixed";
				status = "disabled";
			};

			hifi_codec: hifi-codec {
				phandle = <0x16f>;
				clocks = <&clock_audio_sec>, <0x00>;
				clock-names = "hifi_mclk";
				compatible = "vivo,hifi-codec-pd1805";
				status = "disabled";
			};
		};
	};

	fragment@102 {
		target = <&qupv3_se3_i2c>;

		__overlay__ {
			status = "ok";

			tfa9874_codec_l: tfa9874@34 {
