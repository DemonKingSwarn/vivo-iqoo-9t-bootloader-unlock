/dts-v1/;
/plugin/;

/ {
	qcom,pmic-id = <0x2f 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
	qcom,pmic-id-size = <0x08>;
	model = "Qualcomm Technologies, Inc. Cape QRD with PM8008 PD2217F_EX";
	compatible = "qcom,cape-qrd", "qcom,cape", "qcom,qrd";
	qcom,msm-id = <0x213 0x10000>;
	qcom,board-id = <0x1000b 0x67>;

	fragment@0 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pmk8350: qcom,pmk8350@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x42>;

				pon_hlos@1300 {
					compatible = "qcom,pm8998-pon";
					reg = <0x1300 0x800>;
					reg-names = "pon_hlos", "pon_pbs";
					qcom,log-kpd-event;
					phandle = <0x43>;

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
					};
				};

				pmk8350_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc7";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					pinctrl-names = "default";
					pinctrl-0 = <&pm8350_sbu1_cable_id_adc_default>, <&pm8350_sbu2_cable_id_adc_default>;
					phandle = <0x03>;

					pmk8350_ref_gnd {
						reg = <0x00>;
						label = "pmk8350_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8350_vref_1p25 {
						reg = <0x01>;
						label = "pmk8350_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8350_die_temp {
						reg = <0x03>;
						label = "pmk8350_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmk8350_xo_therm {
						reg = <0x44>;
						label = "pmk8350_xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_ref_gnd {
						reg = <0x100>;
						label = "pm8350_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_vref_1p25 {
						reg = <0x101>;
						label = "pm8350_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_die_temp {
						reg = <0x103>;
						label = "pm8350_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_vph_pwr {
						reg = <0x18e>;
						label = "pm8350_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pm8350b_ref_gnd {
						reg = <0x300>;
						label = "pm8350b_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350b_vref_1p25 {
						reg = <0x301>;
						label = "pm8350b_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350b_die_temp {
						reg = <0x303>;
						label = "pm8350b_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350b_vph_pwr {
						reg = <0x38e>;
						label = "pm8350b_vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pm8350b_vbat_sns {
						reg = <0x38f>;
						label = "pm8350b_vbat_sns";
						qcom,pre-scaling = <0x01 0x03>;
					};

					pmr735a_ref_gnd {
						reg = <0x400>;
						label = "pmr735a_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735a_vref_1p25 {
						reg = <0x401>;
						label = "pmr735a_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735a_die_temp {
						reg = <0x403>;
						label = "pmr735a_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735b_ref_gnd {
						reg = <0x500>;
						label = "pmr735b_ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735b_vref_1p25 {
						reg = <0x501>;
						label = "pmr735b_vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735b_die_temp {
						reg = <0x503>;
						label = "pmr735b_die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735a_4g_pa_therm {
						reg = <0x44a>;
						label = "pmr735a_4g_pa_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,iio-type-override = <0x09>;
						qcom,scale-fn-type = <0x08>;
					};

					pmr735a_5g_pa_therm {
						reg = <0x44b>;
						label = "pmr735a_5g_pa_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pmr735a_wifi_therm {
						reg = <0x44c>;
						label = "pmr735a_wifi_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_msm_therm {
						reg = <0x144>;
						label = "pm8350_msm_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_cam_flash_therm {
						reg = <0x145>;
						label = "pm8350_cam_flash_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_hot_pocket_therm {
						reg = <0x146>;
						label = "pm8350_hot_pocket_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_wide_rfc_therm {
						reg = <0x147>;
						label = "pm8350_wide_rfc_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350b_usb_conn_therm {
						reg = <0x347>;
						label = "pm8350b_usb_conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350b_chg_temp {
						reg = <0x310>;
						label = "pm8350b_chg_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350b_iin_fb {
						reg = <0x317>;
						label = "pm8350b_iin_fb";
						qcom,pre-scaling = <0x20 0x64>;
					};

					pm8350b_ichg_fb {
						reg = <0x3a1>;
						label = "pm8350b_ichg_fb";
						qcom,pre-scaling = <0x3e8 0x4a821>;
					};

					pm8350b_ichg_fb_2x {
						reg = <0x3a1>;
						label = "pm8350b_ichg_fb_2x";
						qcom,pre-scaling = <0x3e8 0x95042>;
						status = "disabled";
					};

					pm8350b_ichg_fb_2p5x {
						reg = <0x3a1>;
						label = "pm8350b_ichg_fb_2p5x";
						qcom,pre-scaling = <0x3e8 0xba453>;
						status = "disabled";
					};

					pm8350b_usb_in_v_div_16 {
						reg = <0x311>;
						label = "pm8350b_usb_in_v_div_16";
						qcom,pre-scaling = <0x01 0x10>;
					};

					smb139x_1_smb_temp {
						reg = <0x906>;
						label = "smb139x_1_smb_temp";
						qcom,hw-settle-time = <0xc8>;
					};

					smb139x_1_ichg_smb {
						reg = <0x918>;
						label = "smb139x_1_ichg_smb";
						qcom,hw-settle-time = <0xc8>;
					};

					smb139x_1_iin_smb {
						reg = <0x919>;
						label = "smb139x_1_iin_smb";
						qcom,hw-settle-time = <0xc8>;
					};

					smb139x_2_smb_temp {
						reg = <0xb06>;
						label = "smb139x_2_smb_temp";
						qcom,hw-settle-time = <0xc8>;
					};

					smb139x_2_ichg_smb {
						reg = <0xb18>;
						label = "smb139x_2_ichg_smb";
						qcom,hw-settle-time = <0xc8>;
					};

					smb139x_2_iin_smb {
						reg = <0xb19>;
						label = "smb139x_2_iin_smb";
						qcom,hw-settle-time = <0xc8>;
					};

					pm8350b_batt_id {
						reg = <0x345>;
						label = "pm8350b_batt_id";
						qcom,pre-scaling = <0x01 0x01>;
						qcom,scale-fn-type = <0x05>;
						qcom,iio-type-override = <0x00>;
					};

					pm8350_usb_con_therm {
						reg = <0x14b>;
						label = "pm8350_usb_con_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_quiet_therm {
						reg = <0x146>;
						label = "pm8350_quiet_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350_bat_btb_m_therm {
						reg = <0x147>;
						label = "pm8350_bat_btb_m_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					sbu1_cable_id_adc {
						reg = <0x148>;
						label = "sbu1_cable_id_adc";
						qcom,pre-scaling = <0x01 0x01>;
					};

					sbu2_cable_id_adc {
						reg = <0x14a>;
						label = "sbu2_cable_id_adc";
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm8350b_batt_therm {
						reg = <0x344>;
						label = "pm8350b_batt_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pmk8350_adc_tm: adc_tm@3400 {
					compatible = "qcom,adc-tm7";
					reg = <0x3400>;
					interrupts = <0x00 0x34 0x00 0x01>;
					interrupt-names = "threshold";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pmk8350_vadc>, <0x144>, <&pmk8350_vadc>, <0x145>, <&pmk8350_vadc>, <0x146>, <&pmk8350_vadc>, <0x147>, <&pmk8350_vadc>, <0x347>, <&pmk8350_vadc>, <0x44>, <&pmk8350_vadc>, <0x14b>;
					phandle = <0x1c>;

					pm8350_msm_therm {
						reg = <0x144>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pm8350_cam_flash_therm {
						reg = <0x145>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pm8350_hot_pocket_therm {
						reg = <0x146>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pm8350_wide_rfc_therm {
						reg = <0x147>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pm8350b_usb_conn_therm {
						reg = <0x347>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pmk8350_xo_therm {
						reg = <0x44>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pm8350_gpio3 {
						reg = <0x14b>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pmk8350_sdam_1: sdam@7000 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7000>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x44>;
				};

				pmk8350_sdam_2: sdam@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x3c>;

					restart_reason: restart@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x19>;
					};

					hap_cl_brake: cl_brake@7c {
						reg = <0x7c 0x01>;
						bits = <0x00 0x08>;
						phandle = <0x0b>;
					};
				};

				pmk8350_sdam_5: sdam@7400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7400>;
					phandle = <0x1a>;
				};

				pmk8350_sdam_13: sdam@7c00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7c00>;
					phandle = <0x10>;
				};

				pmk8350_sdam_14: sdam@7d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7d00>;
					phandle = <0x11>;
				};

				pmk8350_sdam_21: sdam@8400 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8400>;
					phandle = <0x05>;
				};

				pmk8350_sdam_22: sdam@8500 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8500>;
					phandle = <0x06>;
				};

				pmk8350_sdam_23: sdam@8600 {
					compatible = "qcom,spmi-sdam";
					reg = <0x8600>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					phandle = <0x45>;

					adc_scaling: scaling@bf {
						reg = <0xbf 0x01>;
						bits = <0x00 0x02>;
						phandle = <0x46>;
					};
				};

				pmk8350_sdam_41: sdam@9800 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9800>;
					phandle = <0x12>;
				};

				pmk8350_sdam_46: sdam@9d00 {
					compatible = "qcom,spmi-sdam";
					reg = <0x9d00>;
					phandle = <0x0c>;
				};

				pmk8350_gpios: pinctrl@b000 {
					compatible = "qcom,pmk8350-gpio";
					reg = <0xb000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x47>;
				};

				pmk8350_rtc: rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					phandle = <0x48>;
				};

				pmk8350_adc_tm_iio: adc_tm_iio@3400 {
					compatible = "qcom,adc-tm7-iio";
					reg = <0x3400>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pmk8350_vadc>, <0x44a>, <&pmk8350_vadc>, <0x44b>, <&pmk8350_vadc>, <0x44c>;
					phandle = <0x1b>;

					pmr735a_4g_pa_therm {
						reg = <0x44a>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pmr735a_5g_pa_therm {
						reg = <0x44b>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pmr735a_wifi_therm {
						reg = <0x44c>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};
		};
	};

	fragment@1 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8350@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8350_tz: qcom,temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x01 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8350_vadc>, <0x103>;
					io-channel-names = "thermal";
					phandle = <0x04>;
				};

				pm8350_gpios: pinctrl@8800 {
					compatible = "qcom,pm8350-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x2d>;

					pm8350_rear_tof_therm {

						pm8350_rear_tof_therm_default: pm8350_rear_tof_therm_default {
							pins = "gpio1";
							bias-high-impedance;
							phandle = <0x49>;
						};
					};

					key_vol_up {

						key_vol_up_default: key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x2c>;
						};
					};

					pm8350_sbu1_cable_id_adc {

						pm8350_sbu1_cable_id_adc_default: pm8350_sbu1_cable_id_adc_default {
							pins = "gpio1";
							bias-high-impedance;
							phandle = <0x01>;
						};
					};

					pm8350_sbu2_cable_id_adc {

						pm8350_sbu2_cable_id_adc_default: pm8350_sbu2_cable_id_adc_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x02>;
						};
					};

					usb_conn_pro {

						usb_conn_pro_default: usb_conn_pro_default {
							pins = "gpio8";
							function = "normal";
							power-source = <0x00>;
							output-low;
							phandle = <0x3a>;
						};
					};
				};
			};
		};
	};

	fragment@2 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8350_temp_alarm: pm8350_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8350_tz>;
				phandle = <0x4a>;

				trips {

					pm8350_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x24>;
					};

					pm8350_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x4b>;
					};

					pm8350_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x4c>;
					};
				};
			};
		};
	};

	fragment@3 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8350c@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8350c_tz: qcom,temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x02 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x09>;
				};

				pm8350c_gpios: pinctrl@8800 {
					compatible = "qcom,pm8350c-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x08>;

					lcd_backlight_ctrl {

						lcd_backlight_ctrl_default: lcd_backlight_ctrl_default {
							phandle = <0x4d>;
						};
					};

					eusb2_reset_ctrl {

						eusb2_reset_ctrl_default: eusb2_reset_ctrl_default {
							pins = "gpio7";
							function = "normal";
							input-enable;
							output-enable;
							bias-disable;
							power-source = <0x01>;
							qcom,drive-strength = <0x02>;
							phandle = <0x2e>;
						};
					};
				};

				pm8350c_pwm_1: pwms@e800 {
					compatible = "qcom,pwm-lpg";
					reg = <0xe800>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x03>;
					nvmem = <&pmk8350_sdam_21>, <&pmk8350_sdam_22>;
					nvmem-names = "lpg_chan_sdam", "lut_sdam";
					qcom,lut-sdam-base = <0x45>;
					qcom,lut-patterns = <0x00 0x0a 0x14 0x1e 0x28 0x32 0x3c 0x46 0x50 0x5a 0x64 0x5a 0x50 0x46 0x3c 0x32 0x28 0x1e 0x14 0x0a 0x00>;
					qcom,tick-duration-us = <0x1f40>;
					phandle = <0x07>;

					lpg@1 {
						qcom,lpg-chan-id = <0x01>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x48>;
					};

					lpg@2 {
						qcom,lpg-chan-id = <0x02>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x56>;
					};

					lpg@3 {
						qcom,lpg-chan-id = <0x03>;
						qcom,ramp-step-ms = <0x64>;
						qcom,ramp-low-index = <0x00>;
						qcom,ramp-high-index = <0x13>;
						qcom,ramp-pattern-repeat;
						qcom,lpg-sdam-base = <0x64>;
					};
				};

				pm8350c_pwm_2: pwms@eb00 {
					compatible = "qcom,pwm-lpg";
					reg = <0xeb00>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x01>;
					phandle = <0x4e>;
				};

				pm8350c_rgb: qcom,leds@ef00 {
					compatible = "qcom,tri-led";
					reg = <0xef00>;
					phandle = <0x4f>;

					red {
						label = "red";
						pwms = <&pm8350c_pwm_1>, <0x00 0xf4240>;
						led-sources = <0x00>;
						linux,default-trigger = "timer";
					};

					green {
						label = "green";
						pwms = <&pm8350c_pwm_1>, <0x01 0xf4240>;
						led-sources = <0x01>;
						linux,default-trigger = "timer";
					};

					blue {
						label = "blue";
						pwms = <&pm8350c_pwm_1>, <0x02 0xf4240>;
						led-sources = <0x02>;
						linux,default-trigger = "timer";
					};
				};

				pm8350c_bcl: bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x02 0x47 0x00 0x00 0x02 0x47 0x01 0x00 0x02 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x0a>;
				};

				pm8350c_flash: qcom,flash_led@ee00 {
					compatible = "qcom,pm8350c-flash-led";
					reg = <0xee00>;
					interrupts = <0x02 0xee 0x00 0x01 0x02 0xee 0x03 0x01 0x02 0xee 0x04 0x01>;
					interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
					qcom,thermal-derate-current = <0xc8 0x1f4>;
					qcom,hw-strobe-gpios = <&pm8350c_gpios>, <0x01 0x00>;
					status = "ok";
					phandle = <0x50>;

					pm8350c_flash0: qcom,flash_0 {
						status = "ok";
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x51>;
					};

					pm8350c_flash1: qcom,flash_1 {
						status = "ok";
						label = "flash";
						qcom,led-name = "led:flash_1";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash1_trigger";
						qcom,id = <0x03>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x52>;
					};

					pm8350c_flash2: qcom,flash_2 {
						status = "ok";
						label = "flash";
						qcom,led-name = "led:flash_2";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash2_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x53>;
					};

					pm8350c_flash3: qcom,flash_3 {
						status = "ok";
						label = "flash";
						qcom,led-name = "led:flash_3";
						qcom,max-current-ma = <0x5dc>;
						qcom,default-led-trigger = "flash3_trigger";
						qcom,id = <0x03>;
						qcom,duration-ms = <0x136>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x54>;
					};

					pm8350c_torch0: qcom,torch_0 {
						status = "ok";
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x55>;
					};

					pm8350c_torch1: qcom,torch_1 {
						status = "ok";
						label = "torch";
						qcom,led-name = "led:torch_1";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch1_trigger";
						qcom,id = <0x03>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x56>;
					};

					pm8350c_torch2: qcom,torch_2 {
						status = "ok";
						label = "torch";
						qcom,led-name = "led:torch_2";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch2_trigger";
						qcom,id = <0x00>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x57>;
					};

					pm8350c_torch3: qcom,torch_3 {
						status = "ok";
						label = "torch";
						qcom,led-name = "led:torch_3";
						qcom,max-current-ma = <0x1f4>;
						qcom,default-led-trigger = "torch3_trigger";
						qcom,id = <0x03>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x58>;
					};

					pm8350c_switch0: qcom,led_switch_0 {
						label = "switch";
						qcom,led-name = "led:switch_0";
						qcom,default-led-trigger = "switch0_trigger";
						qcom,led-mask = <0x09>;
						phandle = <0x59>;
					};

					pm8350c_switch1: qcom,led_switch_1 {
						label = "switch";
						qcom,led-name = "led:switch_1";
						qcom,default-led-trigger = "switch1_trigger";
						qcom,led-mask = <0x09>;
						phandle = <0x5a>;
					};

					pm8350c_switch2: qcom,led_switch_2 {
						label = "switch";
						qcom,led-name = "led:switch_2";
						qcom,default-led-trigger = "switch2_trigger";
						qcom,led-mask = <0x09>;
						phandle = <0x5b>;
					};

					pm8350c_torch4: qcom,torch_4 {
						phandle = <0x99>;
						qcom,ires-ua = <0x30d4>;
						qcom,id = <0x00>;
						qcom,default-led-trigger = "torch4_trigger";
						qcom,max-current-ma = <0x1f4>;
						qcom,led-name = "led:torch_4";
						label = "torch";
					};

					pm8350c_flash4: qcom,flash_4 {
						phandle = <0x97>;
						qcom,ires-ua = <0x30d4>;
						qcom,duration-ms = <0x136>;
						qcom,id = <0x00>;
						qcom,default-led-trigger = "flash4_trigger";
						qcom,max-current-ma = <0x5dc>;
						qcom,led-name = "led:flash_4";
						label = "flash";
					};

					pm8350c_torch5: qcom,torch_5 {
						phandle = <0x9a>;
						qcom,ires-ua = <0x30d4>;
						qcom,id = <0x03>;
						qcom,default-led-trigger = "torch5_trigger";
						qcom,max-current-ma = <0x1f4>;
						qcom,led-name = "led:torch_5";
						label = "torch";
					};

					pm8350c_flash5: qcom,flash_5 {
						phandle = <0x98>;
						qcom,ires-ua = <0x30d4>;
						qcom,duration-ms = <0x136>;
						qcom,id = <0x03>;
						qcom,default-led-trigger = "flash5_trigger";
						qcom,max-current-ma = <0x5dc>;
						qcom,led-name = "led:flash_5";
						label = "flash";
					};
				};
			};
		};
	};

	fragment@4 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8350c_temp_alarm: pm8350c_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8350c_tz>;
				phandle = <0x5c>;

				trips {

					pm8350c_trip0: trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x25>;
					};

					pm8350c_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x5d>;
					};

					pm8350c_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x5e>;
					};
				};
			};

			pm8350c-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8350c_bcl>, <0x05>;

				trips {

					c_bcl_lvl0: c-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x20>;
					};
				};
			};

			pm8350c-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8350c_bcl>, <0x06>;

				trips {

					c_bcl_lvl1: c-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x21>;
					};
				};
			};

			pm8350c-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm8350c_bcl>, <0x07>;

				trips {

					c_bcl_lvl2: c-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x22>;
					};
				};
			};
		};
	};

	fragment@5 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pm8350b: qcom,pm8350b@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x5f>;

				pm8350b_tz: qcom,temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x03 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8350_vadc>, <0x303>;
					io-channel-names = "thermal";
					phandle = <0x13>;
				};

				pm8350b_pbs2: qcom,pbs@1900 {
					compatible = "qcom,qpnp-pbs";
					reg = <0x1900>;
					phandle = <0x0d>;
				};

				pm8350b_gpios: pinctrl@8800 {
					compatible = "qcom,pm8350b-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x0e>;
				};

				pm8350b_bcl: bcl@4700 {
					compatible = "qcom,bcl-v5";
					reg = <0x4700 0x100>;
					interrupts = <0x03 0x47 0x00 0x00 0x03 0x47 0x01 0x00 0x03 0x47 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					qcom,pmic7-threshold;
					#thermal-sensor-cells = <0x01>;
					phandle = <0x14>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x15>;
				};

				pm8350b_haptics: qcom,hv-haptics@f000 {
					compatible = "qcom,hv-haptics";
					reg = <0xf000 0xf100 0xf200>;
					interrupts = <0x03 0xf0 0x01 0x01>;
					interrupt-names = "fifo-empty";
					qcom,vmax-mv = <0x4f6>;
					qcom,brake-mode = <0x00>;
					qcom,brake-pattern = [ff 3f 1f];
					qcom,lra-period-us = <0x16fa>;
					qcom,drv-sig-shape = <0x01>;
					qcom,brake-sig-shape = <0x01>;
					status = "ok";
					nvmem-cell-names = "hap_cl_brake";
					nvmem-cells = <&hap_cl_brake>;
					nvmem-names = "hap_cfg_sdam";
					nvmem = <&pmk8350_sdam_46>;
					qcom,pbs-client = <&pm8350b_pbs2>;
					irq-gpio = <&pm8350b_gpios>, <0x07 0x00>;
					qcom,brake-disable;
					resistance_min = <0x1388>;
					resistance_max = <0x4e20>;
					freq_min = <0x5dc>;
					freq_max = <0x76c>;
					lra_info = <0x257b>;
					richtap_type = <0x01>;
					scene_array = <&vib_scene_pm8350>;
					vib_num = <0x02>;
					lra,supportVCODE;
					phandle = <0x60>;

					hap_swr_slave_reg: qcom,hap-swr-slave-reg {
						regulator-name = "hap-swr-slave-reg";
						phandle = <0x61>;
					};

					effect_0 {
						qcom,wf-vmax-mv = <0x1f40>;
						qcom,wf-pattern-period-us = <0x16fa>;
						qcom,effect-id = <0x00>;
						qcom,wf-fifo-data = <0x10102 0x3040609 0xc11151b 0x20262b31 0x363c4147 0x4b505358 0x5b5f6264 0x67696a6c 0x6c6d6d6c 0x6c6a6967 0x65625f5c 0x58544f4b 0x46413b36 0x2f2a231d 0x16100802 0xfcf6efe8 0xe2dad4cd 0xc7c0bbb4 0xafa9a4a0 0x9b979390 0x8d8a8885 0x84828281 0x82828284 0x85888b8d 0x9194999d 0xa2a7adb2 0xb9bfc6cc 0xd4dbe3ea 0xf2f90007 0xf161e25 0x2c333a40 0x45494c4e 0x4e4c4844 0x3f39332c 0x261e1810 0x902fcf6 0xefe8e1d9 0xd3ccc7c1 0xbbb6b1ac 0xa8a4a09d 0x9a979693 0x9290908f 0x90909292 0x9496989b 0x9ea1a5a8 0xadb1b6ba 0xc0c5cad0 0xd5dce2e8 0xeef3faff 0x4090f15 0x1b20262a 0x3034393d 0x4245494b 0x4f515455 0x57585a5a 0x5b5a5a59 0x59575653 0x514f4b49 0x45423d3a 0x35312c28 0x231d1914 0x100b0804 0x2000000 0xfffffffe 0xfffefffe 0xfffefffe 0xfffefffe 0x00>;
						qcom,wf-fifo-period = <0x0a>;
						qcom,wf-brake-pattern = [00 00 00];
						qcom,wf-brake-disable;
						qcom,wf-pattern-preload;
