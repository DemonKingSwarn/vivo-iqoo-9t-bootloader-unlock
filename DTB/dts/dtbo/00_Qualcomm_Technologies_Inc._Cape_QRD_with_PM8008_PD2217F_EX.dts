	fragment@49 {
		target = <&tlmm>;

		__overlay__ {

			motor_pin_init: motor_pin_init {
				phandle = <0x91>;

				motor_int_active: motor_int_active {
					phandle = <0x3d>;

					mux {
						pins = "gpio19";
						function = "gpio";
					};

					config {
						pins = "gpio19";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};
			};
		};
	};

