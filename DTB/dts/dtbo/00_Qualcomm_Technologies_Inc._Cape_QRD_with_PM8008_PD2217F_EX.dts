				cam_vio-supply = <&pm8008i_l6>;
				eeprom-src = <&eeprom_front>;
				sensor-position-yaw = <0x00>;
				sensor-position-pitch = <0x00>;
				sensor-position-roll = <0x10e>;
				csiphy-sd-index = <0x03>;
				compatible = "qcom,cam-sensor";
				cell-index = <0x01>;
			};

			qcom,cam-sensor3 {
				status = "ok";
				clock-rates = <0x124f800>;
				clock-cntl-level = "nominal";
				clock-names = "cam_clk";
				clocks = <&clock_camcc>, <0x4c>;
				cci-master = <0x00>;
				gpio-req-tbl-label = "CAMIF_TELE_MCLK0", "CAM_TELE_RESET3";
				gpio-req-tbl-flags = <0x01 0x00>;
				gpio-req-tbl-num = <0x00 0x01>;
				gpio-reset = <0x01>;
				gpios = <&tlmm>, <0x64 0x00>, <&tlmm>, <0x78 0x00>;
				pinctrl-1 = <&cam_sensor_mclk0_suspend>, <&cam_sensor_suspend_rst3>;
				pinctrl-0 = <&cam_sensor_mclk0_active>, <&cam_sensor_active_rst3>;
				pinctrl-names = "cam_default", "cam_suspend";
				gpio-no-mux = <0x00>;
				rgltr-load-current = <0x4e20 0x15f90 0x86470 0x15f90 0x19258 0x00>;
				rgltr-max-voltage = <0x1b7740 0x2ab980 0x101d00 0x2191c0 0x2ab980 0x00>;
				rgltr-min-voltage = <0x1b7740 0x2ab980 0x101d00 0x2191c0 0x2ab980 0x00>;
				rgltr-cntrl-support;
				regulator-names = "cam_vio", "cam_vana", "cam_vdig", "cam_v_custom1", "cam_vaf", "cam_clk";
				cam_clk-supply = <&cam_cc_titan_top_gdsc>;
				cam_vaf-supply = <&L9C>;
				cam_v_custom1-supply = <&pm8008i_l4>;
				cam_vdig-supply = <&pm8008i_l2>;
				cam_vana-supply = <&pm8008i_l3>;
				cam_vio-supply = <&pm8008i_l6>;
				led-flash-src = <&led_flash_triple_rear_aux1>;
				eeprom-src = <&eeprom_tele>;
				actuator-src = <&actuator_tele>;
				sensor-position-yaw = <0xb4>;
				sensor-position-pitch = <0x00>;
				sensor-position-roll = <0x5a>;
				csiphy-sd-index = <0x05>;
				compatible = "qcom,cam-sensor";
				cell-index = <0x03>;
			};
		};
	};

	fragment@90 {
		target = <&cam_req_mgr>;

		__overlay__ {
