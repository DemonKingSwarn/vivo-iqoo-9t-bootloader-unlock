	fragment@55 {
		target = <&tlmm>;

		__overlay__ {

			qupv3_se0_spi_pins: qupv3_se0_spi_pins {
				phandle = <0x93>;

				qupv3_se0_spi_active: qupv3_se0_spi_active {
					phandle = <0x3f>;

					mux {
						pins = "gpio0", "gpio1", "gpio2", "gpio3";
						function = "qup0";
					};

					config {
						pins = "gpio1", "gpio1", "gpio2", "gpio3";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				qupv3_se0_spi_sleep: qupv3_se0_spi_sleep {
					phandle = <0x40>;

					mux {
						pins = "gpio0", "gpio1", "gpio2", "gpio3";
						function = "gpio";
					};

					config {
						pins = "gpio0", "gpio1", "gpio2", "gpio3";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};
		};
	};

	fragment@56 {
		target = <&soc>;

		__overlay__ {

			qupv3_se0_spi: spi@980000 {
				pinctrl-names = "default", "sleep";
				pinctrl-0 = <&qupv3_se0_spi_active>;
				pinctrl-1 = <&qupv3_se0_spi_sleep>;
				custom-timeout-ms = <0x3e8>;
				status = "ok";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x94>;

				irled_spi_38k@01 {
					status = "ok";
					compatible = "qcom_irled_spi";
					reg = <0x00>;
					spi-max-frequency = <0x1e8480>;
				};
			};
		};
	};

	fragment@57 {
		target = <&tlmm>;

		__overlay__ {

			sar_power_state: sar_power_rf_detect {
				phandle = <0x95>;

				sar_power_no_pull: sar_power_no_pull {
					phandle = <0x41>;

					mux {
						pins = "gpio83", "gpio50", "gpio187", "gpio155", "gpio51";
						function = "gpio";
					};

					config {
						pins = "gpio83", "gpio50", "gpio187", "gpio155", "gpio51";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
		};
	};

	fragment@58 {
		target = <&soc>;

		__overlay__ {

			sar_power: sar_power_device {
				compatible = "sar-power";
				interrupt-parent = <&tlmm>;
				interrupts = <0x53 0x02 0x32 0x02 0xbb 0x02 0x9b 0x02 0x33 0x02>;
				sar-power-rf-detect,gpios = <&tlmm>, <0x53 0x00>;
				sar-power-rf-detect_1,gpios = <&tlmm>, <0x32 0x00>;
				sar-power-rf-detect_2,gpios = <&tlmm>, <0xbb 0x00>;
				sar-power-rf-detect_3,gpios = <&tlmm>, <0x9b 0x00>;
				sar-power-rf-detect_4,gpios = <&tlmm>, <0x33 0x00>;
				pinctrl-names = "vivoRF_detect_gpio";
				pinctrl-0 = <&sar_power_no_pull>;
				phandle = <0x96>;
			};
		};
	};

