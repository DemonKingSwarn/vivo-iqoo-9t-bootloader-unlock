	fragment@7 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pmr735a_spmi: qcom,pmr735a@4 {
				compatible = "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x6d>;

				pmr735a_tz: qcom,temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x04 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					io-channels = <&pmk8350_vadc>, <0x403>;
					io-channel-names = "thermal";
					phandle = <0x16>;
				};

				pmr735a_gpios: pinctrl@8800 {
					compatible = "qcom,pmr735a-gpio";
					reg = <0x8800>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x6e>;

					pmr7350a_4g_pa_therm {

						pmr7350a_4g_pa_therm_default: pmr7350a_4g_pa_therm_default {
							pins = "gpio1";
							bias-high-impedance;
							phandle = <0x6f>;
						};
					};

					pmr7350a_5g_pa_therm {

						pmr7350a_5g_pa_therm_default: pmr7350a_5g_pa_therm_default {
							pins = "gpio2";
							bias-high-impedance;
							phandle = <0x70>;
						};
					};

					pmr7350a_wifi_therm {

						pmr7350a_wifi_therm_default: pmr7350a_wifi_therm_default {
							pins = "gpio3";
							bias-high-impedance;
							phandle = <0x71>;
						};
					};
				};
			};
		};
	};

