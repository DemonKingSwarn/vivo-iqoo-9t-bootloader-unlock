						cooling-device = <&cpu_6_7_pause>, <0x01 0x01>;
					};

					vph_gpu1 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&msm_gpu>, <0x04 0x04>;
					};
				};
			};

			pm8350c-bcl-lvl2 {

				cooling-maps {

					vph_cdsp2 {
						trip = <&c_bcl_lvl2>;
						cooling-device = <&cdsp_sw>, <0x05 0xffffffff>;
					};

					vph_gpu2 {
						trip = <&c_bcl_lvl2>;
						cooling-device = <&msm_gpu>, <0x07 0xffffffff>;
					};
				};
			};

			pm8450_tz {

				cooling-maps {

					pm8450_cpu4_freq {
						trip = <&pm8450_trip0>;
						cooling-device = <&CPU4>, <0x0f 0xffffffff>;
					};

					pm8450_cpu7_freq {
						trip = <&pm8450_trip0>;
						cooling-device = <&CPU7>, <0x0f 0xffffffff>;
					};

					pm8450_apc1 {
						trip = <&pm8450_trip0>;
						cooling-device = <&APC1_pause>, <0x01 0x01>;
					};
				};
			};

			pm8350_tz {

				cooling-maps {

					pm8350_gpu {
						trip = <&pm8350_trip0>;
						cooling-device = <&msm_gpu>, <0x07 0xffffffff>;
					};

					pm8350_cpu4_freq {
						trip = <&pm8350_trip0>;
						cooling-device = <&CPU4>, <0x0f 0xffffffff>;
					};

					pm8350_cpu7_freq {
						trip = <&pm8350_trip0>;
						cooling-device = <&CPU7>, <0x0f 0xffffffff>;
					};

					pm8350_apc1 {
						trip = <&pm8350_trip0>;
						cooling-device = <&APC1_pause>, <0x01 0x01>;
					};
				};
			};

			pm8350c_tz {

				cooling-maps {

					pm8350c_nsp {
						trip = <&pm8350c_trip0>;
						cooling-device = <&cdsp_sw>, <0x05 0xffffffff>;
					};

					pm8350c_lte {
						trip = <&pm8350c_trip0>;
						cooling-device = <&modem_lte_dsc>, <0xff 0xff>;
					};

					pm8350c_nr {
						trip = <&pm8350c_trip0>;
						cooling-device = <&modem_nr_scg_dsc>, <0xff 0xff>;
					};
				};
			};

			xo-therm {

				cooling-maps {

					cpu4_freq_cdev {
						trip = <&xo_config0>;
						cooling-device = <&CPU4>, <0x0f 0xffffffff>;
					};

					cpu7_freq_cdev {
						trip = <&xo_config0>;
						cooling-device = <&CPU7>, <0x0f 0xffffffff>;
					};

					apc1_cdev {
						trip = <&xo_config0>;
						cooling-device = <&APC1_pause>, <0x01 0x01>;
					};

					cdsp_cdev {
						trip = <&xo_config0>;
						cooling-device = <&cdsp_sw>, <0x05 0xffffffff>;
					};

					gpu_cdev {
						trip = <&xo_config0>;
						cooling-device = <&msm_gpu>, <0x07 0xffffffff>;
					};

					cpu5_hot_cdev {
						trip = <&xo_config1>;
						cooling-device = <&cpu5_hotplug>, <0x01 0x01>;
					};

					cpu6_hot_cdev {
						trip = <&xo_config1>;
						cooling-device = <&cpu6_hotplug>, <0x01 0x01>;
					};

					cpu7_hot_cdev {
						trip = <&xo_config1>;
						cooling-device = <&cpu7_hotplug>, <0x01 0x01>;
					};

					lte_cdev {
						trip = <&xo_config1>;
						cooling-device = <&modem_lte_dsc>, <0xff 0xff>;
					};

					nr_cdev {
						trip = <&xo_config1>;
						cooling-device = <&modem_nr_scg_dsc>, <0xff 0xff>;
					};

					display_cdev1 {
						trip = <&display_test_config1>;
						cooling-device = <&display_fps>, <0x01 0x01>;
					};

					display_cdev2 {
						trip = <&display_test_config2>;
						cooling-device = <&display_fps>, <0x02 0x02>;
					};

					display_cdev3 {
						trip = <&display_test_config3>;
						cooling-device = <&display_fps>, <0x03 0x03>;
					};

					display_cdev4 {
						trip = <&display_test_config4>;
						cooling-device = <&display_fps>, <0x04 0x04>;
					};
				};
			};
		};
	};

	fragment@16 {
		target = <&soc>;

		__overlay__ {

			vivo_gpio_keys: gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_vol_up_default>;
				phandle = <0x7f>;

				vol_up {
					label = "volume_up";
					gpios = <&pm8350_gpios>, <0x06 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};

				game_key1 {
					label = "game_left";
					gpios = <&tlmm>, <0x3f 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x2f0>;
					gpio-key,wakeup;
					debounce-interval = <0x03>;
				};

				game_key2 {
					label = "game_right";
					gpios = <&tlmm>, <0x42 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x2f1>;
					gpio-key,wakeup;
					debounce-interval = <0x03>;
				};
			};
		};
	};

	fragment@17 {
		target = <&sdhc_2>;

		__overlay__ {
			status = "disabled";
			vdd-supply = <&L9C>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <&L6C>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>;
			qcom,vdd-io-current-level = <0x00 0x1e848>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&sdc2_on>;
			pinctrl-1 = <&sdc2_off>;
			cd-gpios = <&tlmm>, <0x5c 0x01>;
		};
	};

	fragment@18 {
		target = <&ufsphy_mem>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v4-cape";
			vdda-phy-supply = <&L5B>;
			vdda-pll-supply = <&L10C>;
			vdda-phy-max-microamp = <0x30188>;
			vdda-pll-max-microamp = <0x5c94>;
			status = "ok";
		};
	};

	fragment@19 {
		target = <&ufshc_mem>;

		__overlay__ {
			vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
			vcc-supply = <&L7B>;
			vcc-max-microamp = <0x10c8e0>;
			vccq-supply = <&L9B>;
			vccq-max-microamp = <0x124f80>;
			qcom,vddp-ref-clk-supply = <&L9B>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			status = "ok";
		};
	};

	fragment@20 {
		target = <&battery_charger>;

		__overlay__ {
			qcom,thermal-mitigation = <0xaf79e0 0xa7d8c0 0xa037a0 0x989680 0x90f560 0x895440 0x81b320 0x7a1200 0x7270e0 0x6acfc0 0x632ea0 0x5b8d80 0x53ec60 0x4c4b40 0x44aa20 0x3d0900 0x3567e0 0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0xf4240 0x7a120>;
			qcom,wireless-fw-name = "idt9415.bin";
		};
	};

	fragment@21 {
		target = <&qupv3_se5_i2c>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			redriver: redriver@1c {
				compatible = "onnn,redriver";
				reg = <0x1c>;
				lane-channel-swap;
				pinctrl-names = "default";
				pinctrl-0 = <&usb3phy_portselect_gpio>;
				gpios = <&tlmm>, <0x5b 0x00>;
				eq = <0x4040404 0x4060604>;
				flat-gain = <0x3010103 0x30300>;
				output-comp = <0x3030303 0x3030303>;
				loss-match = <0x1030301 0x3030303>;
				phandle = <0x31>;
			};
		};
	};

	fragment@22 {
		target = <&usb_qmp_dp_phy>;

		__overlay__ {
			pinctrl-names = "unused";
		};
	};

	fragment@23 {
		target = <&qupv3_se5_i2c>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nxp_eusb2_repeater: eusb2_repeater@4f {
				compatible = "nxp,eusb2-repeater";
				reg = <0x4f>;
				vdd18-supply = <&S10B>;
				vdd3-supply = <&L2B>;
				reset-gpio = <&pm8350c_gpios>, <0x07 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&eusb2_reset_ctrl_default>;
				qcom,param-override-seq = <0x00 0x00 0x00 0x01 0x00 0x02 0x00 0x03 0x20 0x04 0x10 0x05 0x40 0x06 0x22 0x07 0x66 0x08 0x02 0x09 0x00 0x0a 0x00 0x0b 0x00 0x0c 0x00 0x0d 0x00 0x0e 0x09 0x0f>;
				qcom,param-override-seq-host = <0x00 0x00 0x00 0x01 0x00 0x02 0x00 0x03 0x20 0x04 0x10 0x05 0x40 0x06 0x22 0x07 0x65 0x08 0x02 0x09 0x02 0x0a 0x00 0x0b 0x00 0x0c 0x00 0x0d 0x00 0x0e 0x09 0x0f>;
				phandle = <0x2f>;
			};
		};
	};

	fragment@24 {
		target = <&qupv3_se5_i2c>;

		__overlay__ {
			status = "ok";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ti_eusb2_repeater: eusb2_repeater@3e {
				compatible = "ti,eusb2-repeater";
				reg = <0x3e>;
				qcom,param-override-seq = <0x7c 0x70 0x3c 0x71 0x90 0x72 0x83 0x73 0x00 0x77 0x0b 0x78 0x40 0x79 0x02 0x50 0x02 0xb0 0x00 0xb2 0x00 0xb3 0x00 0xb4 0xc0 0xb6 0x32 0xf5 0x00 0x60>;
				qcom,param-override-seq-host = <0x7c 0x70 0x3c 0x71 0x90 0x72 0x83 0x73 0x00 0x77 0x0b 0x78 0x40 0x79 0x02 0x50 0x02 0xb0 0x00 0xb2 0x00 0xb3 0x00 0xb4 0xc0 0xb6 0x32 0xf5 0x00 0x60>;
				phandle = <0x30>;
			};
		};
	};

	fragment@25 {
		target = <&eusb2_phy0>;

		__overlay__ {
			dummy-supply = <&nxp_eusb2_repeater>, <&ti_eusb2_repeater>;
			usb-repeater = <&nxp_eusb2_repeater>, <&ti_eusb2_repeater>;
		};
	};

	fragment@26 {
		target = <&usb0>;

		__overlay__ {
			ssusb_redriver = <&redriver>;
		};
	};

	fragment@27 {
		target = <&qupv3_se9_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nq@28 {
				status = "ok";
				compatible = "qcom,sn-nci";
				reg = <0x28>;
				vivo,nfc_support = <0x01>;
				vivo,boardversion_shift = <0x00>;
				vivo,boardversion_mask = <0x00>;
				vivo,boardversion_num = <0x00>;
				vivo,boardversions = "0";
				qcom,sn-irq = <&tlmm>, <0x2e 0x00>;
				qcom,sn-ven = <&tlmm>, <0x62 0x00>;
				qcom,sn-firm = <&tlmm>, <0x2d 0x00>;
				qcom,sn-clkreq = <&tlmm>, <0x23 0x00>;
				qcom,sn-vdd-1p8-supply = <&S10B>;
				qcom,sn-vdd-1p8-voltage = <0x1b7740 0x1b7740>;
				qcom,sn-vdd-1p8-current = <0x26548>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x2e 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "nfc_active", "nfc_suspend";
				pinctrl-0 = <&nfc_int_active>, <&nfc_enable_active>;
				pinctrl-1 = <&nfc_int_suspend>, <&nfc_enable_suspend>;
			};
		};
	};

	fragment@28 {
		target = <&usb0>;

		__overlay__ {
			usb-role-switch;

			dwc3@a600000 {
				usb-role-switch;
			};

			port {

				usb_port0: endpoint {
					remote-endpoint = <&usb_port0_connector>;
					phandle = <0x33>;
				};
			};
		};
	};

	fragment@29 {
		target = <&ucsi>;

		__overlay__ {

			connector {

				port {

					usb_port0_connector: endpoint {
						remote-endpoint = <&usb_port0>;
						phandle = <0x32>;
					};
				};
			};
		};
	};

