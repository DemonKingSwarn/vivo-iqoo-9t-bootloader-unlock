		target = <&thermal_zones>;

		__overlay__ {

			pm8350b-bcl-lvl2 {

				cooling-maps {

					vbat_gpu2 {
						cooling-device = <&msm_gpu>, <0x09 0x09>;
					};
				};
			};

			pm8350c-bcl-lvl2 {

				cooling-maps {

					vph_gpu2 {
						cooling-device = <&msm_gpu>, <0x09 0x09>;
					};
				};
			};
		};
	};

	fragment@31 {
		target = <&soc>;

		__overlay__ {

			tcard_sim_slot: tcard_sim {
				status = "ok";
				compatible = "card-detect";
				factory-test,sim1-card;
				factory-test,sim2-card;
				card-detect-sim1,gpios = <&tlmm>, <0x85 0x00>;
				card-detect-sim2,gpios = <&tlmm>, <0x89 0x00>;
				vivo,sim1-reverse-detect;
				vivo,sim2-reverse-detect;
				vivo,tf-card-reverse-detect;
				pinctrl-names = "default";
				pinctrl-0 = <&card_detect>;
				phandle = <0x80>;
			};
		};
	};

	fragment@32 {
		target = <&clock_gcc>;

		__overlay__ {
			qcom,critical-devices = <&qupv3_se5_i2c>;
		};
	};

	fragment@33 {
		target = <&qupv3_se5_i2c>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";

			pm8008i@8 {
				compatible = "qcom,i2c-pmic";
				reg = <0x08>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&pm8008i_active>;

				pm8008-chip@900 {
					compatible = "qcom,pm8008-chip";
					reg = <0x900>;

					PM8008I_EN: qcom,pm8008-chip-en {
						regulator-name = "pm8008i-chip-en";
						phandle = <0x34>;
					};
				};

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
				};
			};

			pm8008i@9 {
				compatible = "qcom,i2c-pmic";
				reg = <0x09>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pm8008i_regulator: qcom,pm8008i-regulator {
					compatible = "qcom,pm8008-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					pm8008_en-supply = <&PM8008I_EN>;
					vdd_l1_l2-supply = <&S12B>;
					vdd_l3_l4-supply = <&BOB>;
					vdd_l5-supply = <&BOB>;
					vdd_l6-supply = <&S1C>;
					vdd_l7-supply = <&BOB>;
					phandle = <0x81>;

					pm8008i_l1: L1I: regulator@4000 {
						reg = <0x4000>;
						regulator-name = "pm8008i_l1";
						regulator-min-microvolt = <0xe09c0>;
						regulator-max-microvolt = <0x10d880>;
						qcom,min-dropout-voltage = <0x5dc0>;
						qcom,hpm-min-load = <0x7530>;
						phandle = <0x82>;
					};

					pm8008i_l2: L2I: regulator@4100 {
						reg = <0x4100>;
						regulator-name = "pm8008i_l2";
						regulator-min-microvolt = "", "\aS";
						regulator-max-microvolt = <0x10d880>;
						qcom,min-dropout-voltage = <0xdac0>;
						qcom,hpm-min-load = <0x7530>;
						phandle = <0x83>;
					};

					pm8008i_l3: L3I: regulator@4200 {
						reg = <0x4200>;
						regulator-name = "pm8008i_l3";
						regulator-min-microvolt = "", "*{";
						regulator-max-microvolt = <0x2c4fc0>;
						qcom,min-dropout-voltage = <0x36b00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x84>;
					};

					pm8008i_l4: L4I: regulator@4300 {
						reg = <0x4300>;
						regulator-name = "pm8008i_l4";
						regulator-min-microvolt = <0x2191c0>;
						regulator-max-microvolt = <0x2ab980>;
						qcom,min-dropout-voltage = <0x251c0>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x85>;
					};

					pm8008i_l5: L5I: regulator@4400 {
						reg = <0x4400>;
						regulator-name = "pm8008i_l5";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2ab980>;
						qcom,min-dropout-voltage = <0x5dc0>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x86>;
					};

					pm8008i_l6: L6I: regulator@4500 {
						reg = <0x4500>;
						regulator-name = "pm8008i_l6";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2ab980>;
						qcom,min-dropout-voltage = <0x186a0>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x87>;
					};

					pm8008i_l7: L7I: regulator@4600 {
						reg = <0x4600>;
						regulator-name = "pm8008i_l7";
						regulator-min-microvolt = <0x2961c0>;
						regulator-max-microvolt = <0x2d2a80>;
						qcom,min-dropout-voltage = <0x48440>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x88>;
					};
				};
			};

			pm8008j@c {
				compatible = "qcom,i2c-pmic";
				reg = <0x0c>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&pm8008j_active>;

				pm8008-chip@900 {
					compatible = "qcom,pm8008-chip";
					reg = <0x900>;

					PM8008J_EN: qcom,pm8008-chip-en {
						regulator-name = "pm8008j-chip-en";
						phandle = <0x35>;
					};
				};

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
				};
			};

			pm8008j@d {
				compatible = "qcom,i2c-pmic";
				reg = <0x0d>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,pm8008j-regulator {
					compatible = "qcom,pm8008-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					pm8008_en-supply = <&PM8008J_EN>;
					vdd_l1_l2-supply = <&S12B>;
					vdd_l3_l4-supply = <&S1C>;
					vdd_l5-supply = <&BOB>;
					vdd_l6-supply = <&BOB>;
					vdd_l7-supply = <&BOB>;

					pm8008j_l1: L1J: regulator@4000 {
						reg = <0x4000>;
						regulator-name = "pm8008j_l1";
						regulator-min-microvolt = <0x10d880>;
						regulator-max-microvolt = <0x10d880>;
						qcom,min-dropout-voltage = <0xfa00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x89>;
					};

					pm8008j_l2: L2J: regulator@4100 {
						reg = <0x4100>;
						regulator-name = "pm8008j_l2";
						regulator-min-microvolt = <0x101d00>;
						regulator-max-microvolt = <0x101d00>;
						qcom,min-dropout-voltage = <0x5dc0>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x8a>;
					};

					pm8008j_l3: L3J: regulator@4200 {
						reg = <0x4200>;
						regulator-name = "pm8008j_l3";
						regulator-min-microvolt = <0x180c40>;
						regulator-max-microvolt = <0x1b7740>;
						qcom,min-dropout-voltage = <0x36b00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x8b>;
					};

					pm8008j_l4: L4J: regulator@4300 {
						reg = <0x4300>;
						regulator-name = "pm8008j_l4";
						regulator-min-microvolt = <0x188940>;
						regulator-max-microvolt = <0x1b7740>;
						qcom,min-dropout-voltage = <0x2ee00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x8c>;
					};

					pm8008j_l5: L5J: regulator@4400 {
						reg = <0x4400>;
						regulator-name = "pm8008j_l5";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
						qcom,min-dropout-voltage = <0xdac0>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x8d>;
					};

					pm8008j_l6: L6J: regulator@4500 {
						reg = <0x4500>;
						regulator-name = "pm8008j_l6";
						regulator-min-microvolt = <0x2ab980>;
						regulator-max-microvolt = <0x2ab980>;
						qcom,min-dropout-voltage = <0x1d4c0>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x8e>;
					};

					pm8008j_l7: L7J: regulator@4600 {
						reg = <0x4600>;
						regulator-name = "pm8008j_l7";
						regulator-min-microvolt = "", ",o";
						regulator-max-microvolt = <0x326a40>;
						qcom,min-dropout-voltage = <0x17700>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x8f>;
					};
				};
			};
		};
	};

