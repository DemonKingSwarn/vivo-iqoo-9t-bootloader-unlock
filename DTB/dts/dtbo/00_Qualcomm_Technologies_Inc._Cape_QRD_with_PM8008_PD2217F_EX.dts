	fragment@36 {
		target = <&qupv3_se4_spi>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@37 {
		target = <&qupv3_se4_i2c>;

		__overlay__ {
			status = "okay";

			gt9916@5d {
				compatible = "goodix,gt9897";
				reg = <0x5d>;
				vts-type = <0x00>;
				vts-ic-number = <0x32>;
				goodix,avdd-name = "avddvtouch";
				avddvtouch-supply = <&pm8350c_l11>;
				goodix,iovdd-name = "vtouch";
				vtouch-supply = <&pm8350c_l2>;
				interrupt-parent = <&tlmm>;
				goodix,reset-gpio = <&tlmm>, <0x14 0x00>;
				goodix,irq-gpio = <&tlmm>, <0x15 0x00>;
				goodix,irq-flags = <0x02>;
				goodix,panel-max-id = <0x0a>;
				goodix,panel-max-x = <0x438>;
				goodix,panel-max-y = <0x948>;
				goodix,panel-max-w = <0x200>;
				goodix,panel-max-p = <0x200>;
				goodix,pen-enable;
				goodix,power-on-delay-us = <0x493e0>;
				goodix,power-off-delay-us = <0x186a0>;
				goodix,i2c-read-max-size = <0x800>;
				sensor-test-key = "com.goodix:GTMTest:android.intent.action.goodix:0:goodixTestResult";
				lcm-noise-test-key = "com.goodix.deltadiff:DeltaDiffActivity:action.null:null:null";
				rawdata-test-key = "com.goodix.deltadiff:DataShowActivity:null:null:null";
				rf-noise-test-key = "com.goodix.deltadiff:BspTestActivity:com.goodix.deltadiff.action.Receiver:0:GOODIX_DELTA";
			};

			sec_ts@48 {
				compatible = "samsung,y761";
				reg = <0x48>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x15 0x2008>;
				vcc_i2c-supply = <&pm8350c_l2>;
				avdd_pwr-supply = <&pm8350c_l11>;
				samsung,reset-gpio = <&tlmm>, <0x14 0x00>;
				samsung,irq-gpio = <&tlmm>, <0x15 0x00>;
				vts-ic-number = <0x48>;
				vts-type = <0x00>;
				sensor-test-key = "com.detection.ts.touch_detection:MainActivity:com.detection.ts.touch_detection:0:secTpResult";
				lcm-noise-test-key = "com.detection.ts.noise_detection_apk:MainActivity:null:null:null";
				rf-noise-test-key = "com.detection.ts.noise_detection_apk:BspTestActivity:com.detection.ts.noise_detection_apk:0:secBspResult";
				rawdata-test-key = "com.detection.ts.noise_detection_apk:DataShowActivity:null:null:null";
			};

			tcm_i2c@2c {
				compatible = "synaptics, synaptics-3618";
				reg = <0x2c>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x15 0x2008>;
				synaptics,bus-reg-name = "vcc_i2c";
				vcc_i2c-supply = <&pm8350c_l2>;
				synaptics,pwr-reg-name = "avdd_pwr";
				avdd_pwr-supply = <&pm8350c_l11>;
				synaptics,reset-gpio = <&tlmm>, <0x14 0x00>;
				synaptics,irq-gpio = <&tlmm>, <0x15 0x2008>;
				vts-ic-number = <0x41>;
				vts-type = <0x00>;
				synaptics,irq-on-state = <0x00>;
				synaptics,reset-on-state = <0x00>;
				synaptics,reset-active-ms = <0x1e>;
				synaptics,reset-delay-ms = <0x1e>;
				synaptics,power-delay-ms = <0x3c>;
				synaptics,ubl-i2c-addr = <0x2c>;
				synaptics,power-on-state = <0x01>;
				synaptics,noise-level-state = <0x01>;
				sensor-test-key = "com.touchscreen.vtstouchscreencheck:MainActivity:android.intent.action.vtsCheck:0:vtsTestResult";
				lcm-noise-test-key = "com.vivotouchscreen.synadeltadiff:MainActivity:null:null:null";
				rf-noise-test-key = "com.vivotouchscreen.synadeltadiff:SynaBspTest:vivotouchscreen.SynaBspTest:0:vivotouchscreen.SynaBspTest";
				rawdata-test-key = "com.vivotouchscreen.synadeltadiff:DataShow:null:null:null";
			};
		};
	};

	fragment@38 {
		target = <&tlmm>;

		__overlay__ {

			cs_press_pl {

				ndt_key1_default: ndt_key1_default {
					phandle = <0x36>;

					mux {
						pins = "gpio63";
						function = "gpio";
					};

					config {
						pins = "gpio63";
						drive-strength = <0x10>;
						bias-pull-up;
						input-enable;
					};
				};

				ndt_key2_default: ndt_key2_default {
					phandle = <0x37>;

					mux {
						pins = "gpio66";
						function = "gpio";
					};

					config {
						pins = "gpio66";
						drive-strength = <0x10>;
						bias-pull-up;
						input-enable;
					};
				};
			};
		};
	};

	fragment@39 {
		target = <&qupv3_se1_spi>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@40 {
		target = <&qupv3_se1_i2c>;

		__overlay__ {
			status = "ok";

			cs_press@50 {
				compatible = "cs_press_pt100,f61";
				reg = <0x50>;
				tp-display-y = <0x960>;
				press,module_id = <0xd01>;
				press,rst-gpio = <&tlmm>, <0x0e 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&ndt_key1_default>, <&ndt_key2_default>;
			};

			cs_aw8680x_press@5c {
				compatible = "awinic,cs_aw8680x_press";
				reg = <0x5c>;
				tp-display-y = <0x960>;
				press,module_id = <0xe01>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x46 0x2002>;
				state-gpio = <&tlmm>, <0x46 0x00>;
				reset-gpio = <&tlmm>, <0x0e 0x00>;
				wakeup-gpio = <&tlmm>, <0x5c 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&ndt_key1_default>, <&ndt_key2_default>;
			};
		};
	};

	fragment@41 {
		target = <&tlmm>;

		__overlay__ {

			usbsel_gpio {

				usbsel_gpio_default: usbsel_gpio_default {
					phandle = <0x38>;

					mux {
						pins = "gpio122";
						function = "gpio";
					};

					config {
						pins = "gpio122";
						drive-strength = <0x02>;
						output-low;
						bias-pull-down;
					};
				};
			};

			cout_gpio {

				cout_gpio_default: cout_gpio_default {
					phandle = <0x39>;

					mux {
						pins = "gpio10";
						function = "gpio";
					};

					config {
						pins = "gpio10";
						drive-strength = <0x02>;
						bias-disable;
						input-enable;
					};
				};
			};
		};
	};

	fragment@42 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8350-gpio3 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pmk8350_adc_tm>, <0x14b>;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};

					active-config1 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@43 {
		target = <&apps_rsc>;

		__overlay__ {

			rpmh-regulator-ldoc3 {
				qcom,send-defaults;

				pm8350c_l3: L3C: regulator-pm8350c-l3 {
					regulator-name = "pm8350c_l3";
					qcom,set = <0x03>;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x326a40>;
					qcom,init-voltage = <0x325aa0>;
					qcom,init-mode = <0x04>;
					qcom,init-enable = <0x00>;
					phandle = <0x3b>;
				};
			};
		};
	};

	fragment@44 {
		target = <&battery_charger>;

		__overlay__ {
			vivo,ex-fg-psy-name = "bq_bms";
			vivo,use-cms-batt-thermal;
			vivo,soc-decimal-enable;
			vivo,equalizing-chg-tbat-limit = <0x1c2>;
			vivo,equalizing-chg-tboard-limit = <0x1c2>;
		};
	};

	fragment@45 {
		target = <&qupv3_se13_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0x186a0>;

			battery@55 {
				status = "ok";
				compatible = "ti,bq28z610-db";
				reg = <0x55>;
				vivo,bat-capacity-mah = <0x8f2>;
				vivo,empty-voltage-mv = <0xd48>;
				vivo,soc-remap-enable;
				vivo,remap-soc-list-size = <0x02>;
				vivo,remove-soc-list = <0x1c 0x30>;
				vivo,add-soc-list = <0x62 0x63>;
				vivo,ap-update-ra0-ra1;
				vivo,remcap-update-time = <0x1518>;
				vivo,min-resistance-points = <0x04>;
				vivo,current-at-eoc = <0x00 0x12c 0x73>;
				vivo,delta-voltage = <0x05 0x1e 0x05>;
				vivo,cell0-volt-at-eoc = <0x1130 0x11da 0x114e>;
