	fragment@87 {
		target = <&soc>;

		__overlay__ {

			led_flash_rear: qcom,camera-flash@0 {
				phandle = <0x9f>;
				status = "ok";
				switch-source = <&pm8350c_switch0>;
				torch-source = <&pm8350c_torch0>, <&pm8350c_torch1>;
				flash-source = <&pm8350c_flash0>, <&pm8350c_flash1>;
				compatible = "qcom,camera-flash";
				two-source-for-one-led = <0x01>;
				rear-flash = <0x01>;
				cell-index = <0x00>;
			};

			led_flash_ultra_wide: qcom,camera-flash@1 {
				phandle = <0xa2>;
				status = "ok";
				switch-source = <&pm8350c_switch1>;
				torch-source = <&pm8350c_torch2>, <&pm8350c_torch3>;
				flash-source = <&pm8350c_flash2>, <&pm8350c_flash3>;
				compatible = "qcom,camera-flash";
				cell-index = <0x01>;
			};

			led_flash_triple_rear_aux1: qcom,camera-flash@2 {
				phandle = <0xa7>;
				status = "ok";
				switch-source = <&pm8350c_switch2>;
				torch-source = <&pm8350c_torch4>, <&pm8350c_torch5>;
				flash-source = <&pm8350c_flash4>, <&pm8350c_flash5>;
				compatible = "qcom,camera-flash";
				cell-index = <0x02>;
			};

			camera1_vdig_ldo: camera-vdig-regulator@0 {
				phandle = <0xa4>;
				vin-supply = <&S12B>;
				gpio = <&tlmm>, <0xb1 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0xe9>;
				regulator-max-microvolt = <0x100590>;
				regulator-min-microvolt = <0x100590>;
				regulator-name = "camera1_vdig_ldo";
				reg = <0x00 0x00>;
				compatible = "regulator-fixed";
			};

			qcom,cam-res-mgr {
				pinctrl-1 = <&cam_sensor_mclk2_suspend>;
				pinctrl-0 = <&cam_sensor_mclk2_active>;
				pinctrl-names = "mclk2_active", "mclk2_suspend";
				shared-pctrl-gpio-names = "mclk2";
				gpios-shared-pinctrl = <0x193>;
				gpios-shared = <0x66>;
				status = "ok";
				compatible = "qcom,cam-res-mgr";
			};

			camera_rear_main_reset: camera-regulator@0 {
				phandle = <0x9b>;
				gpio = <&tlmm>, <0x75 0x00>;
				enable-active-high;
				regulator-enable-ramp-delay = <0xe9>;
				regulator-max-microvolt = <0x1b7740>;
				regulator-min-microvolt = <0x1b7740>;
				regulator-name = "camera_rear_main_reset";
				reg = <0x00 0x00>;
				compatible = "regulator-fixed";
			};
		};
	};

