	fragment@63 {
		target = <&tlmm>;

		__overlay__ {

			display_panel_avdd_default: display_panel_avdd_default {
				phandle = <0x82>;

				mux {
					function = "gpio";
					pins = "gpio168";
				};

				config {
					output-high;
					bias-disable = <0x00>;
					drive-strength = <0x08>;
					pins = "gpio168";
				};
			};

			display_panel_extvdd_default: display_panel_extvdd_default {
				phandle = <0x83>;

				mux {
					function = "gpio";
					pins = "gpio148";
				};

				config {
					output-high;
					bias-disable = <0x00>;
					drive-strength = <0x08>;
					pins = "gpio148";
				};
			};

			pmx_sde: pmx_sde {
				phandle = <0xa0>;

				sde_dsi_active: sde_dsi_active {
					phandle = <0x76>;

					mux {
						function = "gpio";
						pins = "gpio42";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio42";
					};
				};

				sde_dsi_suspend: sde_dsi_suspend {
					phandle = <0x78>;

					mux {
						function = "gpio";
						pins = "gpio42";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio42";
					};
				};

				sde_dsi1_active: sde_dsi1_active {
					phandle = <0x7d>;

					mux {
						function = "gpio";
						pins = "gpio4";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio4";
					};
				};

				sde_dsi1_suspend: sde_dsi1_suspend {
					phandle = <0x7f>;

					mux {
						function = "gpio";
						pins = "gpio4";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio4";
					};
				};
			};

			pmx_sde_te: pmx_sde_te {
				phandle = <0xa1>;

				sde_te_active: sde_te_active {
					phandle = <0x77>;

					mux {
