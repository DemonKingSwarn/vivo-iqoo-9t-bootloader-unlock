	fragment@9 {
		target = <&gcc>;

		__overlay__ {
			qcom,critical-devices = <&qupv3_se2_i2c>;
		};
	};

	fragment@10 {
		target = <&qupv3_se2_i2c>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";

			pm8010i@8 {
				compatible = "qcom,i2c-pmic";
				reg = <0x08>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&pm8010i_active>;

				pm8010-chip@900 {
					compatible = "qcom,pm8008-chip";
					reg = <0x900>;

					PM8010I_EN: qcom,pm8008-chip-en {
						regulator-name = "pm8010i-chip-en";
						phandle = <0x0e>;
					};
				};

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
				};
			};

			pm8010i@9 {
				compatible = "qcom,i2c-pmic";
				reg = <0x09>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,pm8010i-regulator {
					compatible = "qcom,pm8010-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					pm8008_en-supply = <&PM8010I_EN>;
					vdd_l1_l2-supply = <&S8B>;
					vdd_l3_l4-supply = <&BOB>;
					vdd_l5-supply = <&BOB>;
					vdd_l6-supply = <&BOB>;
					vdd_l7-supply = <&BOB>;

					pm8010i_l1: L1I: regulator@4000 {
						reg = <0x4000>;
						regulator-name = "pm8010i_l1";
						regulator-min-microvolt = <0x3e030>;
						regulator-max-microvolt = <0x124f80>;
						qcom,min-dropout-voltage = <0x1f400>;
						qcom,hpm-min-load = <0x7530>;
						phandle = <0x4c>;
					};

					pm8010i_l2: L2I: regulator@4100 {
						reg = <0x4100>;
						regulator-name = "pm8010i_l2";
						regulator-min-microvolt = <0x43df0>;
						regulator-max-microvolt = <0x118c30>;
						qcom,min-dropout-voltage = <0x19640>;
						qcom,hpm-min-load = <0x7530>;
						phandle = <0x4d>;
					};

					pm8010i_l3: L3I: regulator@4200 {
						reg = <0x4200>;
						regulator-name = "pm8010i_l3";
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2dc6c0>;
						qcom,min-dropout-voltage = <0x2ee00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x4e>;
					};

					pm8010i_l4: L4I: regulator@4300 {
						reg = <0x4300>;
						regulator-name = "pm8010i_l4";
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2c4020>;
						qcom,min-dropout-voltage = <0x1f400>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x4f>;
					};

					pm8010i_l5: L5I: regulator@4400 {
						reg = <0x4400>;
						regulator-name = "pm8010i_l5";
						regulator-min-microvolt = <0x16f300>;
						regulator-max-microvolt = <0x3613c0>;
						qcom,min-dropout-voltage = <0x00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x50>;
					};

					pm8010i_l6: L6I: regulator@4500 {
						reg = <0x4500>;
						regulator-name = "pm8010i_l6";
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2c4020>;
						qcom,min-dropout-voltage = <0x1f400>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x51>;
					};

					pm8010i_l7: L7I: regulator@4600 {
						reg = <0x4600>;
						regulator-name = "pm8010i_l7";
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2dc6c0>;
						qcom,min-dropout-voltage = <0x3e800>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x52>;
					};
				};
			};

			pm8010j@c {
				compatible = "qcom,i2c-pmic";
				reg = <0x0c>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&pm8010j_active>;

				pm8010-chip@900 {
					compatible = "qcom,pm8008-chip";
					reg = <0x900>;

					PM8010J_EN: qcom,pm8008-chip-en {
						regulator-name = "pm8010j-chip-en";
						phandle = <0x10>;
					};
				};

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100>;
				};
			};

			pm8010j@d {
				compatible = "qcom,i2c-pmic";
				reg = <0x0d>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				qcom,pm8010j-regulator {
					compatible = "qcom,pm8010-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					pm8008_en-supply = <&PM8010J_EN>;
					vdd_l1_l2-supply = <&S8B>;
					vdd_l3_l4-supply = <&S1B>;
					vdd_l5-supply = <&BOB>;
					vdd_l6-supply = <&BOB>;
					vdd_l7-supply = <&BOB>;

					pm8010j_l1: L1J: regulator@4000 {
						reg = <0x4000>;
						regulator-name = "pm8010j_l1";
						regulator-min-microvolt = <0x4baf0>;
						regulator-max-microvolt = <0x118c30>;
						qcom,min-dropout-voltage = <0x11940>;
						qcom,hpm-min-load = <0x7530>;
						phandle = <0x53>;
					};

					pm8010j_l2: L2J: regulator@4100 {
						reg = <0x4100>;
						regulator-name = "pm8010j_l2";
						regulator-min-microvolt = <0x57670>;
						regulator-max-microvolt = <0x16acb0>;
						qcom,min-dropout-voltage = <0x5dc0>;
						qcom,hpm-min-load = <0x7530>;
						phandle = <0x54>;
					};

					pm8010j_l3: L3J: regulator@4200 {
						reg = <0x4200>;
						regulator-name = "pm8010j_l3";
						regulator-min-microvolt = <0x18d760>;
						regulator-max-microvolt = <0x1dc130>;
						qcom,min-dropout-voltage = <0x11940>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x55>;
					};

					pm8010j_l4: L4J: regulator@4300 {
						reg = <0x4300>;
						regulator-name = "pm8010j_l4";
						regulator-min-microvolt = <0x179ee0>;
						regulator-max-microvolt = <0x1ccf00>;
						qcom,min-dropout-voltage = <0x251c0>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x56>;
					};

					pm8010j_l5: L5J: regulator@4400 {
						reg = <0x4400>;
						regulator-name = "pm8010j_l5";
						regulator-min-microvolt = <0x16f300>;
						regulator-max-microvolt = <0x3613c0>;
						qcom,min-dropout-voltage = <0x00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x57>;
					};

					pm8010j_l6: L6J: regulator@4500 {
						reg = <0x4500>;
						regulator-name = "pm8010j_l6";
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2c4020>;
						qcom,min-dropout-voltage = <0x1f400>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x58>;
					};

					pm8010j_l7: L7J: regulator@4600 {
						reg = <0x4600>;
						regulator-name = "pm8010j_l7";
						regulator-min-microvolt = <0x16f300>;
						regulator-max-microvolt = <0x3613c0>;
						qcom,min-dropout-voltage = <0x00>;
						qcom,hpm-min-load = <0x00>;
						phandle = <0x59>;
					};
				};
			};
		};
	};

	fragment@11 {
		target = <&thermal_zones>;

		__overlay__ {

			pm8350c-bcl-lvl0 {

				cooling-maps {

					vph_lte0 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&modem_lte_dsc>, <0x08 0x08>;
					};

					vph_nr0_scg {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&modem_nr_scg_dsc>, <0x03 0x03>;
					};

					vph_nr0 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&modem_nr_dsc>, <0x06 0x06>;
					};

					vph_cdsp0 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&cdsp_sw>, <0x02 0x02>;
					};

					vph_cpu_5 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&cpu5_pause>, <0x01 0x01>;
					};

					vph_gpu0 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&msm_gpu>, <0x01 0x01>;
					};
				};
			};

			pm8350c-bcl-lvl1 {

				cooling-maps {

					vph_lte1 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&modem_lte_dsc>, <0x0a 0x0a>;
					};

					vph_nr1_scg {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&modem_nr_scg_dsc>, <0x0a 0x0a>;
					};

					vph_nr1 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&modem_nr_dsc>, <0x09 0x09>;
					};

					vph_cdsp1 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&cdsp_sw>, <0x04 0x04>;
					};

					vph_cpu_6_7 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&cpu_6_7_pause>, <0x01 0x01>;
					};

					vph_gpu1 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};
				};
			};

			pm8350c-bcl-lvl2 {

				cooling-maps {

					vph_cdsp2 {
						trip = <&c_bcl_lvl2>;
						cooling-device = <&cdsp_sw>, <0x05 0xffffffff>;
					};

					vph_gpu2 {
						trip = <&c_bcl_lvl2>;
						cooling-device = <&msm_gpu>, <0x03 0xffffffff>;
					};
				};
			};

			pm8350c_tz {

				cooling-maps {

					pm8350c_lte {
						trip = <&pm8350c_trip0>;
						cooling-device = <&modem_lte_dsc>, <0xff 0xff>;
					};

					pm8350c_nr {
						trip = <&pm8350c_trip0>;
						cooling-device = <&modem_nr_scg_dsc>, <0xff 0xff>;
					};

					pm8350c_gpu {
						trip = <&pm8350c_trip0>;
						cooling-device = <&msm_gpu>, <0x03 0xffffffff>;
					};
				};
			};

			pm7325_tz {

				cooling-maps {

					pm7325_cpu4_freq {
						trip = <&pm7325_trip0>;
						cooling-device = <&CPU4>, <0x0a 0xffffffff>;
					};

					pm7325_cpu7_freq {
						trip = <&pm7325_trip0>;
						cooling-device = <&CPU7>, <0x0c 0xffffffff>;
					};

					pm7325_apc1 {
						trip = <&pm7325_trip0>;
						cooling-device = <&APC1_pause>, <0x01 0x01>;
					};
				};
			};
		};
	};

	fragment@12 {
		target = <&soc>;

		__overlay__ {

			gpio_keys {
				compatible = "gpio-keys";
				label = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <&key_vol_up_default>;

				vol_up {
					label = "volume_up";
					gpios = <&pm7325_gpios>, <0x06 0x01>;
					linux,input-type = <0x01>;
					linux,code = <0x73>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
					linux,can-disable;
				};
			};
		};
	};

	fragment@13 {
		target = <&qupv3_se0_i2c>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			qcom,i2c-touch-active = "novatek,NVT-ts";

			novatek@62 {
				compatible = "novatek,NVT-ts";
				reg = <0x62>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x33 0x2008>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend>, <&ts_reset_suspend>;
				pinctrl-2 = <&ts_release>;
				novatek,reset-gpio = <&tlmm>, <0x11 0x00>;
				novatek,irq-gpio = <&tlmm>, <0x33 0x2008>;
				novatek,trusted-touch-mode = "vm_mode";
				novatek,touch-environment = "pvm";
				novatek,trusted-touch-spi-irq = <0x236>;
				novatek,trusted-touch-io-bases = <0x980000 0x910000>;
				novatek,trusted-touch-io-sizes = <0x1000 0x4000>;
				novatek,trusted-touch-vm-gpio-list = <&tlmm>, <0x00 0x00>, <&tlmm>, <0x01 0x00>, <&tlmm>, <0x02 0x00>, <&tlmm>, <0x03 0x00>, <&tlmm>, <0x11 0x00>, <&tlmm>, <0x33 0x2008>;
			};

			focaltech@38 {
				compatible = "focaltech,fts_ts";
				reg = <0x38>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x33 0x2008>;
				focaltech,reset-gpio = <&tlmm>, <0x11 0x00>;
				focaltech,irq-gpio = <&tlmm>, <0x33 0x2008>;
				focaltech,max-touch-number = <0x05>;
				focaltech,display-coords = <0x00 0x00 0x438 0x924>;
				focaltech,touch-type = "primary";
				vdd-supply = <&L3C>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend>, <&ts_reset_suspend>;
				pinctrl-2 = <&ts_release>;
			};

			synaptics_dsx@22 {
				compatible = "synaptics,dsx-i2c";
				reg = <0x22>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x33 0x2008>;
				avdd-supply = <&L3C>;
				vdd-supply = <&L12C>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend>, <&ts_reset_suspend>;
				pinctrl-2 = <&ts_release>;
				synaptics,pwr-reg-name = "avdd";
				synaptics,bus-reg-name = "vdd";
				synaptics,ub-i2c-addr = <0x22>;
				synaptics,max-y-for-2d = <0x743>;
				synaptics,irq-gpio = <&tlmm>, <0x33 0x2008>;
				synaptics,reset-gpio = <&tlmm>, <0x11 0x00>;
				synaptics,irq-on-state = <0x00>;
				synaptics,power-delay-ms = <0xc8>;
				synaptics,reset-delay-ms = <0xc8>;
				synaptics,reset-on-state = <0x00>;
				synaptics,reset-active-ms = <0x14>;
			};

			atmel_mxt_ts@4a {
				compatible = "atmel,maxtouch";
				reg = <0x4a>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x33 0x2008>;
				avdd-supply = <&L3C>;
				vdd-supply = <&L12C>;
				pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
				pinctrl-0 = <&ts_active>;
				pinctrl-1 = <&ts_int_suspend>, <&ts_reset_suspend>;
				atmel,xy_switch;
				atmel,inverty;
				atmel,invertx;
				reset-gpios = <&tlmm>, <0x11 0x00>;
				irq-gpios = <&tlmm>, <0x33 0x2008>;
				atmel,panel-coords = <0x00 0x00 0x1df 0x31f>;
				atmel,display-coords = <0x00 0x00 0x153 0x2d9>;
			};
		};
	};

	fragment@14 {
		target = <&qupv3_se9_i2c>;

		__overlay__ {
			status = "ok";
			qcom,clk-freq-out = <0xf4240>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			nq@28 {
				compatible = "qcom,sn-nci";
				reg = <0x28>;
				qcom,sn-irq = <&tlmm>, <0x29 0x00>;
				qcom,sn-ven = <&tlmm>, <0x26 0x00>;
				qcom,sn-firm = <&tlmm>, <0x28 0x00>;
				qcom,sn-clkreq = <&tlmm>, <0x27 0x00>;
				qcom,sn-vdd-1p8-supply = <&L18B>;
				qcom,sn-vdd-1p8-voltage = <0x1b7740 0x1b7740>;
				qcom,sn-vdd-1p8-current = <0x26548>;
				interrupt-parent = <&tlmm>;
				interrupts = <0x29 0x00>;
				interrupt-names = "nfc_irq";
				pinctrl-names = "nfc_active", "nfc_suspend";
				pinctrl-0 = <&nfc_int_active>, <&nfc_enable_active>;
				pinctrl-1 = <&nfc_int_suspend>, <&nfc_enable_suspend>;
			};
		};
	};

	fragment@15 {
		target = <&sdhc_2>;

		__overlay__ {
			status = "ok";
			vdd-supply = <&L9C>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <&L6C>;
			qcom,vdd-io-voltage-level = <0x1b7740 0x2d2a80>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&sdc2_on>;
			pinctrl-1 = <&sdc2_off>;
			cd-gpios = <&tlmm>, <0x13 0x01>;
		};
	};

	fragment@16 {
		target = <&ufsphy_mem>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qmp-v4-diwali";
			vdda-phy-supply = <&L10C>;
			vdda-pll-supply = <&L6B>;
			vdda-phy-max-microamp = <0x15824>;
			vdda-pll-max-microamp = <0x477c>;
			status = "ok";
		};
	};

	fragment@17 {
		target = <&ufshc_mem>;

		__overlay__ {
			vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
			vcc-supply = <&L7B>;
			vcc-max-microamp = <0x10c8e0>;
			vccq-supply = <&L9B>;
			vccq-max-microamp = <0x124f80>;
			vccq2-supply = <&L19B>;
			vccq2-max-microamp = "", "\f5";
			qcom,vddp-ref-clk-supply = <&L9B>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			ufs-dev-types = <0x02>;
			nvmem-cells = <&ufs_dev>;
			nvmem-cell-names = "ufs_dev";
			status = "ok";
		};
	};

	fragment@18 {
		target = <&spmi_bus>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			pm7250b_2: qcom,pm7250b@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x08 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x5a>;

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800>;
				};

				pm7250b_charger: qcom,qpnp-smb5 {
					compatible = "qcom,pm7250b-smb5";
					depends-on-supply = <&pm7250b_vadc>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#cooling-cells = <0x02>;
					qcom,thermal-mitigation = <0x5265c0 0x44aa20 0x3d0900 0x3567e0 0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0xf4240 0x7a120>;
					status = "disabled";
					phandle = <0x5b>;

					qcom,chgr@1000 {
						reg = <0x1000>;
						interrupts = <0x02 0x10 0x00 0x01 0x02 0x10 0x01 0x01 0x02 0x10 0x02 0x01 0x02 0x10 0x03 0x01 0x02 0x10 0x04 0x01 0x02 0x10 0x05 0x01 0x02 0x10 0x06 0x01 0x02 0x10 0x07 0x01>;
						interrupt-names = "chgr-error", "chg-state-change", "step-chg-state-change", "step-chg-soc-update-fail", "step-chg-soc-update-req", "fg-fvcal-qualified", "vph-alarm", "vph-drop-prechg";
					};

					qcom,dcdc@1100 {
						reg = <0x1100>;
						interrupts = <0x02 0x11 0x00 0x01 0x02 0x11 0x01 0x01 0x02 0x11 0x02 0x01 0x02 0x11 0x03 0x03 0x02 0x11 0x04 0x03 0x02 0x11 0x05 0x03 0x02 0x11 0x06 0x01 0x02 0x11 0x07 0x03>;
						interrupt-names = "otg-fail", "otg-oc-disable-sw", "otg-oc-hiccup", "bsm-active", "high-duty-cycle", "input-current-limiting", "concurrent-mode-disable", "switcher-power-ok";
					};

					qcom,batif@1200 {
						reg = <0x1200>;
						interrupts = <0x02 0x12 0x00 0x01 0x02 0x12 0x02 0x03 0x02 0x12 0x03 0x03 0x02 0x12 0x04 0x03 0x02 0x12 0x05 0x03 0x02 0x12 0x06 0x03 0x02 0x12 0x07 0x03>;
						interrupt-names = "bat-temp", "bat-ov", "bat-low", "bat-therm-or-id-missing", "bat-terminal-missing", "buck-oc", "vph-ov";
					};

					qcom,usb@1300 {
						reg = <0x1300>;
						interrupts = <0x02 0x13 0x00 0x03 0x02 0x13 0x01 0x03 0x02 0x13 0x02 0x03 0x02 0x13 0x03 0x03 0x02 0x13 0x04 0x03 0x02 0x13 0x05 0x03 0x02 0x13 0x06 0x01 0x02 0x13 0x07 0x01>;
						interrupt-names = "usbin-collapse", "usbin-vashdn", "usbin-uv", "usbin-ov", "usbin-plugin", "usbin-revi-change", "usbin-src-change", "usbin-icl-change";
					};

					qcom,dc@1400 {
						reg = <0x1400>;
						interrupts = <0x02 0x14 0x01 0x03 0x02 0x14 0x02 0x03 0x02 0x14 0x03 0x03 0x02 0x14 0x04 0x03 0x02 0x14 0x05 0x03 0x02 0x14 0x06 0x01 0x02 0x14 0x07 0x01>;
						interrupt-names = "dcin-vashdn", "dcin-uv", "dcin-ov", "dcin-plugin", "dcin-revi", "dcin-pon", "dcin-en";
					};

					qcom,typec@1500 {
						reg = <0x1500>;
						interrupts = <0x02 0x15 0x00 0x01 0x02 0x15 0x01 0x01 0x02 0x15 0x02 0x01 0x02 0x15 0x03 0x01 0x02 0x15 0x04 0x01 0x02 0x15 0x05 0x01 0x02 0x15 0x06 0x01 0x02 0x15 0x07 0x01>;
						interrupt-names = "typec-or-rid-detect-change", "typec-vpd-detect", "typec-cc-state-change", "typec-vconn-oc", "typec-vbus-change", "typec-attach-detach", "typec-legacy-cable-detect", "typec-try-snk-src-detect";
					};

					qcom,misc@1600 {
						reg = <0x1600>;
						interrupts = <0x02 0x16 0x00 0x01 0x02 0x16 0x01 0x01 0x02 0x16 0x02 0x01 0x02 0x16 0x03 0x01 0x02 0x16 0x04 0x03 0x02 0x16 0x05 0x01 0x02 0x16 0x06 0x01 0x02 0x16 0x07 0x01>;
						interrupt-names = "wdog-snarl", "wdog-bark", "aicl-fail", "aicl-done", "smb-en", "imp-trigger", "temp-change", "temp-change-smb";
					};

					qcom,chg-sdam@b000 {
						reg = <0xb000>;
					};
				};

				pm7250b_qg: qpnp,qg {
					compatible = "qcom,pm7250b-qg";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					qcom,vbatt-cutoff-mv = <0xc80>;
					qcom,vbatt-low-mv = <0xce4>;
					qcom,vbatt-low-cold-mv = <0xe74>;
					qcom,vbatt-empty-mv = <0xbb8>;
					qcom,vbatt-empty-cold-mv = <0xbb8>;
					qcom,s3-entry-fifo-length = <0x02>;
					status = "disabled";
					phandle = <0x5c>;

					qcom,qgauge@4800 {
						status = "okay";
						reg = <0x4800>;
						interrupts = <0x02 0x48 0x00 0x03 0x02 0x48 0x01 0x03 0x02 0x48 0x02 0x01 0x02 0x48 0x03 0x01 0x02 0x48 0x04 0x01>;
						interrupt-names = "qg-batt-missing", "qg-vbat-low", "qg-vbat-empty", "qg-fifo-done", "qg-good-ocv";
					};

					qcom,qg-sdam@b100 {
						status = "okay";
						reg = <0xb100>;
					};
				};

				pm7250b_tz: qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x08 0x24 0x00 0x03>;
					io-channels = <&pm7250b_vadc>, <0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x1a>;
				};

				pm7250b_clkdiv: clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm7250b_div_clk1";
					clocks = <&rpmhcc>, <0x00>;
					clock-names = "xo";
					status = "disabled";
					phandle = <0x5d>;
				};

				pm7250b_vadc: vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x08 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x19>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					vbat_sns@84 {
						reg = <0x84>;
						label = "vbat_sns";
						qcom,pre-scaling = <0x01 0x03>;
					};

					usb_in_i_uv@7 {
						reg = <0x07>;
						label = "usb_in_i_uv";
						qcom,pre-scaling = <0x01 0x01>;
					};

					usb_in_v_div_16@8 {
						reg = <0x08>;
						label = "usb_in_v_div_16";
						qcom,pre-scaling = <0x01 0x10>;
					};

					chg_temp@9 {
						reg = <0x09>;
						label = "chg_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_therm@4a {
						reg = <0x4a>;
						label = "bat_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_therm_30k@2a {
						reg = <0x2a>;
						label = "bat_therm_30k";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_therm_400k@6a {
						reg = <0x6a>;
						label = "bat_therm_400k";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_id@4b {
						reg = <0x4b>;
						label = "bat_id";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1390_therm@e {
						reg = <0x0e>;
						label = "smb1390_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						qcom,scale-fn-type = <0x10>;
					};

					chg_sbux@99 {
						reg = <0x99>;
						label = "chg_sbux";
						qcom,pre-scaling = <0x01 0x03>;
					};

					mid_chg_div6@1e {
						reg = <0x1e>;
						label = "chg_mid";
						qcom,pre-scaling = <0x01 0x06>;
					};

					pm7250b_usb_conn_therm {
						reg = <0x4f>;
						label = "pm7250b_usb_conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pm7250b_smb_skin_therm {
						reg = <0x4d>;
						label = "pm7250b_smb_skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				pm7250b_adc_tm: adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500>;
					interrupts = <0x08 0x35 0x00 0x01>;
					interrupt-names = "threshold";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <&pm7250b_vadc>, <0x4f>, <&pm7250b_vadc>, <0x4d>;
					phandle = <0x22>;

					pm7250b_usb_conn_therm {
						reg = <0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pm7250b_smb_skin_therm {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};

				pm7250b_bcl: bcl@1d00 {
					compatible = "qcom,bcl-v5";
					reg = <0x1d00>;
					interrupts = <0x08 0x1d 0x00 0x01 0x08 0x1d 0x01 0x01 0x08 0x1d 0x02 0x01>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					#thermal-sensor-cells = <0x01>;
					phandle = <0x1b>;
				};

				bcl_soc: bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x1c>;
				};

				pm7250b_gpios: pinctrl@c000 {
					compatible = "qcom,pm7250b-gpio";
					reg = <0xc000>;
					gpio-controller;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x5e>;
				};

				pm7250b_pdphy: qcom,usb-pdphy@1700 {
					compatible = "qcom,qpnp-pdphy";
					reg = <0x1700 0x100>;
					interrupts = <0x02 0x17 0x00 0x01 0x02 0x17 0x01 0x01 0x02 0x17 0x02 0x01 0x02 0x17 0x03 0x01 0x02 0x17 0x04 0x01 0x02 0x17 0x05 0x01 0x02 0x17 0x06 0x01 0x02 0x17 0x07 0x01>;
					interrupt-names = "sig-tx", "sig-rx", "msg-tx", "msg-rx", "msg-tx-failed", "msg-tx-discarded", "msg-rx-discarded", "fr-swap";
					qcom,default-sink-caps = <0x1388 0xbb8 0x2328 0xbb8 0x2ee0 0x8ca>;
					status = "disabled";
					phandle = <0x5f>;
				};
			};

			pm7250b_3: qcom,pm7250b@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x09 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x60>;

				pm7250b_vib: qcom,vibrator@5300 {
					compatible = "qcom,qpnp-vibrator-ldo";
					reg = <0x5300>;
					qcom,vib-ldo-volt-uv = <0x2dc6c0>;
					qcom,disable-overdrive;
					phandle = <0x61>;
				};
			};
		};
	};

	fragment@19 {
		target = <&thermal_zones>;

		__overlay__ {

			pm7250b_temp_alarm: pm7250b_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_tz>;
				phandle = <0x62>;

				trips {

					pm7250b_trip0: trip0 {
						temperature = <0x15f90>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x63>;
					};

					pm7250b_trip1: trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x64>;
					};

					pm7250b_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x65>;
					};
				};
			};

			pm7250b-ibat-lvl0 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl>, <0x00>;

				trips {

					ibat_lvl0: ibat-lvl0 {
						temperature = <0x157c>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x66>;
					};
				};
			};

			pm7250b-ibat-lvl1 {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl>, <0x01>;

				trips {

					ibat_lvl1: ibat-lvl1 {
						temperature = <0x1770>;
						hysteresis = <0xc8>;
						type = "passive";
						phandle = <0x67>;
					};
				};
			};

			pm7250b-bcl-lvl0 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl>, <0x05>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl0: b-bcl-lvl0 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x1f>;
					};
				};
			};

			pm7250b-bcl-lvl1 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl>, <0x06>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl1: b-bcl-lvl1 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x20>;
					};
				};
			};

			pm7250b-bcl-lvl2 {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&pm7250b_bcl>, <0x07>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					b_bcl_lvl2: b-bcl-lvl2 {
						temperature = <0x01>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x21>;
					};
				};
			};

			socd {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <&bcl_soc>;

				trips {

					thermal-engine-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					thermal-hal-trip {
						temperature = <0x64>;
						hysteresis = <0x00>;
						type = "passive";
					};

					socd_trip: socd-trip {
						temperature = <0x5a>;
						hysteresis = <0x01>;
						type = "passive";
						phandle = <0x1e>;
					};
				};
			};
		};
	};

	fragment@20 {
		target = <&soc>;

		__overlay__ {

			qcom,pmic_glink {
				status = "okay";
			};

			qcom,pmic_glink_log {
				compatible = "qcom,pmic-glink";
				qcom,pmic-glink-channel = "PMIC_LOGS_ADSP_APPS";

				qcom,battery_debug {
					compatible = "qcom,battery-debug";
				};

				qcom,charger_ulog_glink {
					compatible = "qcom,charger-ulog-glink";
				};

				spmi_glink_debug: qcom,spmi_glink_debug {
					compatible = "qcom,spmi-glink-debug";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					depends-on-supply = <&spmi1_bus>;
					phandle = <0x68>;

					spmi@0 {
						reg = <0x00>;
						#address-cells = <0x02>;
						#size-cells = <0x00>;

						qcom,pm7250b-debug@8 {
							compatible = "qcom,spmi-pmic";
							reg = <0x08 0x00>;
							qcom,can-sleep;
						};
					};

					spmi@1 {
						reg = <0x01>;
						#address-cells = <0x02>;
						#size-cells = <0x00>;

						smb1394_glink_debug: qcom,smb1394-debug@9 {
							compatible = "qcom,spmi-pmic";
							reg = <0x09 0x00>;
							qcom,can-sleep;
							phandle = <0x1d>;
						};

						qcom,smb1394-debug@b {
							compatible = "qcom,spmi-pmic";
							reg = <0x0b 0x00>;
							qcom,can-sleep;
						};

						qcom,smb1394-debug@d {
							compatible = "qcom,spmi-pmic";
							reg = <0x0c 0x00>;
							qcom,can-sleep;
						};
					};
				};
			};
		};
	};

	fragment@21 {
		target = <&glink_edge>;

		__overlay__ {

			qcom,pmic_glink_rpmsg {
				qcom,glink-channels = "PMIC_RTR_ADSP_APPS";
			};

			qcom,pmic_glink_log_rpmsg {
				qcom,glink-channels = "PMIC_LOGS_ADSP_APPS";
				qcom,intents = <0x800 0x05 0xc00 0x03 0x2000 0x01>;
			};
		};
	};

	fragment@22 {
		target = <&spmi0_debug_bus>;

		__overlay__ {
			depends-on2-supply = <&smb1394_glink_debug>;
		};
	};

	fragment@23 {
		target = <&thermal_zones>;

		__overlay__ {

			socd {

				cooling-maps {

					socd_apc1 {
						trip = <&socd_trip>;
						cooling-device = <&APC1_pause>, <0x01 0x01>;
					};

					socd_cdsp1 {
						trip = <&socd_trip>;
						cooling-device = <&cdsp_sw>, <0x04 0x04>;
					};

					socd_gpu0 {
						trip = <&socd_trip>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};
				};
			};

			pm7250b-ibat-lvl0 {

				trips {

					ibat-lvl0 {
						temperature = <0x1770>;
					};
				};
			};

			pm7250b-ibat-lvl1 {

				trips {

					ibat-lvl1 {
						temperature = <0x1d4c>;
					};
				};
			};

			pm7250b-bcl-lvl0 {

				cooling-maps {

					vbat_lte0 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&modem_lte_dsc>, <0x08 0x08>;
					};

					vbat_nr0_scg {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&modem_nr_scg_dsc>, <0x03 0x03>;
					};

					vbat_nr0 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&modem_nr_dsc>, <0x06 0x06>;
					};

					vbat_cdsp0 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&cdsp_sw>, <0x02 0x02>;
					};

					vbat_cpu_5 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&cpu5_pause>, <0x01 0x01>;
					};

					vbat_gpu0 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&msm_gpu>, <0x01 0x01>;
					};
				};
			};

			pm7250b-bcl-lvl1 {

				cooling-maps {

					vbat_lte1 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&modem_lte_dsc>, <0x0a 0x0a>;
					};

					vbat_nr1_scg {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&modem_nr_scg_dsc>, <0x0a 0x0a>;
					};

					vbat_nr1 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&modem_nr_dsc>, <0x09 0x09>;
					};

					vbat_cdsp1 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&cdsp_sw>, <0x04 0x04>;
					};

					vbat_cpu_6_7 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&cpu_6_7_pause>, <0x01 0x01>;
					};

					vbat_gpu1 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};
				};
			};

			pm7250b-bcl-lvl2 {

				cooling-maps {

					vbat_cdsp2 {
						trip = <&b_bcl_lvl2>;
						cooling-device = <&cdsp_sw>, <0x05 0xffffffff>;
					};

					vbat_gpu2 {
						trip = <&b_bcl_lvl2>;
						cooling-device = <&msm_gpu>, <0x03 0xffffffff>;
					};
				};
			};

			conn-therm {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pm7250b_adc_tm>, <0x4f>;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};

					active-config1 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};

			chg-skin-therm {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pm7250b_adc_tm>, <0x4d>;

				trips {

					active-config0 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};

					active-config1 {
						temperature = <0x1e848>;
						hysteresis = <0x3e8>;
						type = "passive";
					};
				};
			};
		};
	};

