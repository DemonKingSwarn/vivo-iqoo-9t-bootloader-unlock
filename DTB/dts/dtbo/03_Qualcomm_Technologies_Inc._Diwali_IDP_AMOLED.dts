						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio82";
					};
				};

				sde_te_suspend: sde_te_suspend {
					phandle = <0x79>;

					mux {
						function = "mdp_vsync";
						pins = "gpio82";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio82";
					};
				};

				sde_te1_active: sde_te1_active {
					phandle = <0x7e>;

					mux {
						function = "mdp_vsync";
						pins = "gpio81";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio81";
					};
				};

				sde_te1_suspend: sde_te1_suspend {
					phandle = <0x80>;

