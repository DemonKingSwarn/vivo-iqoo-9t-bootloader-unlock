				swr0: wsa_swr_master {
					phandle = <0x15d>;
					qcom,dynamic-port-map-supported = <0x00>;
					qcom,swr-num-dev = <0x02>;
					qcom,swr-port-mapping = <0x01 0x01 0x01 0x02 0x02 0x0f 0x03 0x03 0x03 0x04 0x05 0x01 0x05 0x06 0x0f 0x06 0x07 0x03 0x07 0x04 0x03 0x08 0x08 0x03>;
