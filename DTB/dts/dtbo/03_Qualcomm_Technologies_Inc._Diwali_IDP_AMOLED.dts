						phandle = <0xbc>;
						status = "disabled";
						reg = <0x0d 0x1170224>;
						compatible = "qcom,wcd938x-slave";
					};

					wcd937x_rx_slave: wcd937x-rx-slave {
						phandle = <0xba>;
						reg = <0x0a 0x1170224>;
						compatible = "qcom,wcd937x-slave";
						status = "okay";
					};
				};
			};

			wsa_macro: wsa-macro@3240000 {
				phandle = <0x15c>;
				#cooling-cells = <0x02>;
				qcom,thermal-max-state = <0x0b>;
