					};

					pmr735a_trip2: trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x4b>;
					};
				};
			};
		};
	};

	fragment@7 {
		target = <&soc>;

		__overlay__ {

