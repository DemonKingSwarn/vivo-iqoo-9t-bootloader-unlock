	};

	fragment@60 {
		target = <&qcom_msmhdcp>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@61 {
		target = <&sde_dp>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@62 {
		target = <&sde_rscc>;

		__overlay__ {
