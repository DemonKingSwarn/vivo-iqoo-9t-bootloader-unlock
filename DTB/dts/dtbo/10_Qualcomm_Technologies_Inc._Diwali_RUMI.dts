/dts-v1/;
/plugin/;

/ {
	model = "Qualcomm Technologies, Inc. Diwali RUMI";
	compatible = "qcom,diwali-rumi", "qcom,diwali", "qcom,rumi";
	qcom,msm-id = <0x1fa 0x10000>;
	qcom,board-id = <0x1000f 0x00>;

	fragment@0 {
		target = <&soc>;

		__overlay__ {

			timer {
				clock-frequency = <0x7a120>;
			};

			timer@17420000 {
				clock-frequency = <0x7a120>;
			};

			qcom,wdt@17410000 {
				status = "disabled";
			};

			usb_nop_phy: usb_nop_phy {
				compatible = "usb-nop-xceiv";
				phandle = <0x03>;
			};

			usb_emuphy: phy@a784000 {
				compatible = "qcom,usb-emu-phy";
				reg = <0xa784000 0x9500>;
				qcom,emu-init-seq = <0xfffff 0x04 0xffff0 0x04 0x100000 0x20 0x00 0x20 0x101f0 0x20 0x100000 0x3c 0x00 0x3c 0x00 0x04>;
				phandle = <0x02>;
			};

			bi_tcxo: bi_tcxo {
				compatible = "fixed-factor-clock";
				clock-mult = <0x01>;
				clock-div = <0x04>;
				clocks = <&xo_board>;
				#clock-cells = <0x00>;
				phandle = <0x01>;
			};

			bi_tcxo_ao: bi_tcxo_ao {
				compatible = "fixed-factor-clock";
				clock-mult = <0x01>;
				clock-div = <0x04>;
				clocks = <&xo_board>;
				#clock-cells = <0x00>;
				phandle = <0x04>;
			};
		};
	};

	fragment@1 {
		target = <&sdhc_2>;

		__overlay__ {
			status = "ok";
			vdd-supply = <&L9C>;
			qcom,vdd-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-current-level = <0x00 0xc3500>;
			vdd-io-supply = <&L6C>;
			qcom,vdd-io-voltage-level = <0x2d2a80 0x2d2a80>;
			qcom,vdd-io-current-level = <0x00 0x55f0>;
			cap-sd-highspeed;
			max-frequency = <0x5f5e100>;
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <&sdc2_on>;
			pinctrl-1 = <&sdc2_off>;
			cd-gpios = <&tlmm>, <0x13 0x01>;
		};
	};

	fragment@2 {
		target = <&gcc>;

		__overlay__ {
			clocks = <&bi_tcxo>, <&sleep_clk>, <&pcie_0_pipe_clk>, <&ufs_phy_rx_symbol_0_clk>, <&ufs_phy_rx_symbol_1_clk>, <&ufs_phy_tx_symbol_0_clk>, <&usb3_phy_wrapper_gcc_usb30_pipe_clk>;
		};
	};

	fragment@3 {
		target = <&LITTLE_CPU_OFF>;

		__overlay__ {
			status = "nok";
		};
	};

	fragment@4 {
		target = <&LITTLE_CPU_RAIL_OFF>;

		__overlay__ {
			status = "nok";
		};
	};

	fragment@5 {
		target = <&BIG_CPU_OFF>;

		__overlay__ {
			status = "nok";
		};
	};

	fragment@6 {
		target = <&BIG_CPU_RAIL_OFF>;

		__overlay__ {
			status = "nok";
		};
	};

	fragment@7 {
		target = <&CLUSTER_OFF>;

		__overlay__ {
			status = "nok";
		};
	};

	fragment@8 {
		target = <&CX_RET>;

		__overlay__ {
			status = "nok";
		};
	};

	fragment@9 {
		target = <&APSS_OFF>;

		__overlay__ {
			status = "nok";
		};
	};

	fragment@10 {
		target = <&usb0>;

		__overlay__ {

			dwc3@a600000 {
				usb-phy = <&usb_emuphy>, <&usb_nop_phy>;
				dr_mode = "peripheral";
				maximum-speed = "high-speed";
			};
		};
	};

	fragment@11 {
		target = <&gpucc>;

		__overlay__ {
			clocks = <&bi_tcxo>, <&gcc>, <0x1c>, <&gcc>, <0x1d>;
		};
	};

	fragment@12 {
		target = <&camcc>;

		__overlay__ {
			clocks = <&bi_tcxo>, <&bi_tcxo_ao>, <&sleep_clk>, <&gcc>, <0x08>;
		};
	};

	fragment@13 {
		target = <&qupv3_se5_2uart>;

		__overlay__ {
			qcom,rumi_platform;
		};
	};

	fragment@14 {
		target = <&videocc>;

		__overlay__ {
			clocks = <&bi_tcxo>, <&bi_tcxo_ao>, <&sleep_clk>, <&gcc>, <0x80>;
		};
	};

	fragment@15 {
		target = <&ufsphy_mem>;

		__overlay__ {
			compatible = "qcom,ufs-phy-qrbtc-sdm845";
			vdda-phy-supply = <&L10C>;
			vdda-pll-supply = <&L6B>;
			vdda-phy-max-microamp = <0x14f28>;
			vdda-pll-max-microamp = <0x477c>;
			status = "ok";
		};
	};

	fragment@16 {
		target = <&ufshc_mem>;

		__overlay__ {
			limit-tx-hs-gear = <0x01>;
			limit-rx-hs-gear = <0x01>;
			limit-rate = <0x02>;
			vdd-hba-supply = <&gcc_ufs_phy_gdsc>;
			vdd-hba-fixed-regulator;
			vcc-supply = <&L7B>;
			vcc-max-microamp = "", "\f5";
			vccq-supply = <&L9B>;
			vccq-max-microamp = <0xb71b0>;
			vccq2-supply = <&L19B>;
			vccq2-max-microamp = <0xb71b0>;
			qcom,vddp-ref-clk-supply = <&L9B>;
			qcom,vddp-ref-clk-max-microamp = <0x64>;
			qcom,disable-lpm;
			rpm-level = <0x00>;
			spm-level = <0x00>;
			qcom,iommu-dma = "bypass";
			status = "ok";
		};
	};

	fragment@17 {
		target = <&tsens0>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@18 {
		target = <&tsens1>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@19 {
		target = <&rpmhcc>;

		__overlay__ {
			compatible = "qcom,dummycc";
			clock-output-names = "rpmhcc_clocks";
		};
	};

	fragment@20 {
		target = <&dispcc>;

		__overlay__ {
			clocks = <&bi_tcxo>, <&bi_tcxo_ao>, <&sleep_clk>, <&gcc>, <0x10>;
		};
	};

	fragment@21 {
		target = <&cpufreq_hw>;

		__overlay__ {
			clocks = <&bi_tcxo>, <&gcc>, <0x00>;
		};
	};

	fragment@22 {
		target = <&debugcc>;

		__overlay__ {
			clocks = <&bi_tcxo>;
		};
	};

	__symbols__ {
		demura_memory_1 = "/fragment@52/__overlay__/demura_region_1";
		demura_memory_0 = "/fragment@52/__overlay__/demura_region_0";
		splash_memory = "/fragment@52/__overlay__/splash_region";
		disp_rdump_memory = "/fragment@51/__overlay__/disp_rdump_region@e1000000";
		sde_wb = "/fragment@51/__overlay__/qcom,wb-display@0";
