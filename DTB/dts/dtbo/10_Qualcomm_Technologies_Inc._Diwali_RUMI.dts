	fragment@49 {
		target = <&tlmm>;

		__overlay__ {

			display_panel_avdd_default: display_panel_avdd_default {
				phandle = <0x10>;

				mux {
					function = "gpio";
					pins = "gpio168";
				};

				config {
					output-high;
					bias-disable = <0x00>;
					drive-strength = <0x08>;
					pins = "gpio168";
				};
			};

			display_panel_extvdd_default: display_panel_extvdd_default {
				phandle = <0x12>;

				mux {
					function = "gpio";
					pins = "gpio148";
				};

				config {
					output-high;
					bias-disable = <0x00>;
					drive-strength = <0x08>;
					pins = "gpio148";
				};
			};

			pmx_sde: pmx_sde {
				phandle = <0x2f>;

				sde_dsi_active: sde_dsi_active {
					phandle = <0x05>;

					mux {
						function = "gpio";
						pins = "gpio42";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio42";
					};
				};

				sde_dsi_suspend: sde_dsi_suspend {
					phandle = <0x07>;

					mux {
						function = "gpio";
						pins = "gpio42";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio42";
					};
				};

				sde_dsi1_active: sde_dsi1_active {
					phandle = <0x0b>;

					mux {
						function = "gpio";
						pins = "gpio4";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio4";
					};
				};

				sde_dsi1_suspend: sde_dsi1_suspend {
					phandle = <0x0d>;

					mux {
						function = "gpio";
						pins = "gpio4";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio4";
					};
				};
			};

			pmx_sde_te: pmx_sde_te {
				phandle = <0x30>;

				sde_te_active: sde_te_active {
					phandle = <0x06>;

					mux {
						function = "mdp_vsync";
						pins = "gpio82";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio82";
					};
				};

				sde_te_suspend: sde_te_suspend {
					phandle = <0x08>;

					mux {
						function = "mdp_vsync";
						pins = "gpio82";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio82";
					};
				};

				sde_te1_active: sde_te1_active {
					phandle = <0x0c>;

					mux {
						function = "mdp_vsync";
						pins = "gpio81";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio81";
					};
				};

				sde_te1_suspend: sde_te1_suspend {
					phandle = <0x0e>;

					mux {
						function = "mdp_vsync";
						pins = "gpio81";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio81";
					};
				};
			};
		};
	};

