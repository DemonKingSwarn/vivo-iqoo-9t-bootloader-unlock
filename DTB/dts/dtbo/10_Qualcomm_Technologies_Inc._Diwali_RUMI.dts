				qcom,panel-supply-entry@2 {
					qcom,supply-disable-load = <0x00>;
					qcom,supply-enable-load = <0x00>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-name = "lab";
					reg = <0x02>;
				};

				qcom,panel-supply-entry@3 {
					qcom,supply-post-on-sleep = <0x14>;
					qcom,supply-disable-load = <0x00>;
					qcom,supply-enable-load = <0x00>;
					qcom,supply-max-voltage = <0x5b8d80>;
					qcom,supply-min-voltage = <0x4630c0>;
					qcom,supply-name = "ibb";
					reg = <0x03>;
				};

				qcom,panel-supply-entry@4 {
					qcom,supply-post-on-sleep = <0x00>;
					qcom,supply-disable-load = <0x50>;
					qcom,supply-enable-load = <0xed1c>;
					qcom,supply-max-voltage = <0x124f80>;
					qcom,supply-min-voltage = <0x124f80>;
					qcom,supply-name = "extvdd";
					reg = <0x04>;
				};
			};

			sde_dsi: qcom,dsi-display-primary {
				phandle = <0x13>;
				status = "disabled";
				ibb-supply = <&display_panel_ibb>;
				vci-supply = <&L13C>;
				vddio-supply = <&L12C>;
				touch_avdd-supply = <&L3C>;
				clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk";
				clocks = <&mdss_dsi_phy0>, <0x00>, <&mdss_dsi_phy0>, <0x01>, <&mdss_dsi_phy1>, <0x02>, <&mdss_dsi_phy1>, <0x03>, <&dispcc>, <0x3e>;
				qcom,demura-panel-id = <0x122e700 0xb0>;
				qcom,dsi-default-panel = <&dsi_nt36672e_dsc_fhd_plus_60hz_video>;
				qcom,mdp = <&mdss_mdp>;
				qcom,panel-te-source = <0x00>;
				qcom,platform-te-gpio = <&tlmm>, <0x52 0x00>;
				pinctrl-1 = <&sde_dsi_suspend>, <&sde_te_suspend>;
				pinctrl-0 = <&sde_dsi_active>, <&sde_te_active>;
				pinctrl-names = "panel_active", "panel_suspend";
				qcom,dsi-phy = <&mdss_dsi_phy0>, <&mdss_dsi_phy1>;
				qcom,dsi-ctrl = <&mdss_dsi0>, <&mdss_dsi1>;
				label = "primary";
				compatible = "qcom,dsi-display";
			};

			sde_dsi1: qcom,dsi-display-secondary {
				phandle = <0x14>;
				ibb-supply = <&display_panel_ibb>;
				vci-supply = <&L13C>;
				vddio-supply = <&L12C>;
				touch_avdd-supply = <&L3C>;
				clock-names = "pll_byte_clk0", "pll_dsi_clk0", "pll_byte_clk1", "pll_dsi_clk1", "mdp_core_clk";
				clocks = <&mdss_dsi_phy0>, <0x00>, <&mdss_dsi_phy0>, <0x01>, <&mdss_dsi_phy1>, <0x02>, <&mdss_dsi_phy1>, <0x03>, <&dispcc>, <0x3e>;
				qcom,demura-panel-id = <0x00 0x00>;
				qcom,mdp = <&mdss_mdp>;
				qcom,panel-te-source = <0x01>;
				qcom,platform-te-gpio = <&tlmm>, <0x51 0x00>;
				pinctrl-1 = <&sde_dsi1_suspend>, <&sde_te1_suspend>;
				pinctrl-0 = <&sde_dsi1_active>, <&sde_te1_active>;
				pinctrl-names = "panel_active", "panel_suspend";
				qcom,dsi-phy = <&mdss_dsi_phy0>, <&mdss_dsi_phy1>;
				qcom,dsi-ctrl = <&mdss_dsi0>, <&mdss_dsi1>;
				label = "secondary";
				compatible = "qcom,dsi-display";
			};
		};
	};

	fragment@51 {
		target = <&soc>;

		__overlay__ {

			display_panel_avdd: display_gpio_regulator@1 {
				phandle = <0x0f>;
				pinctrl-0 = <&display_panel_avdd_default>;
				pinctrl-names = "default";
				qcom,proxy-consumer-enable;
				proxy-supply = <&display_panel_avdd>;
				regulator-boot-on;
				enable-active-high;
				gpio = <&tlmm>, <0xa8 0x00>;
				regulator-enable-ramp-delay = <0xe9>;
				regulator-max-microvolt = <0x53ec60>;
				regulator-min-microvolt = <0x53ec60>;
				regulator-name = "display_panel_avdd";
				compatible = "qti-regulator-fixed";
			};

			display_panel_extvdd: display_gpio_regulator@2 {
				phandle = <0x11>;
				pinctrl-0 = <&display_panel_extvdd_default>;
				pinctrl-names = "default";
				qcom,proxy-consumer-enable;
				proxy-supply = <&display_panel_extvdd>;
				regulator-boot-on;
				enable-active-high;
				gpio = <&tlmm>, <0x94 0x00>;
				regulator-enable-ramp-delay = <0xe9>;
				regulator-max-microvolt = <0x124f80>;
				regulator-min-microvolt = <0x124f80>;
				regulator-name = "display_panel_extvdd";
				compatible = "qti-regulator-fixed";
			};

			display_panel_ibb: display_panel_ibb_stub {
				phandle = <0x0a>;
				regulator-max-microvolt = <0x5b8d80>;
				regulator-min-microvolt = <0x4630c0>;
				regulator-name = "display_panel_ibb";
				compatible = "qcom,stub-regulator";
			};

			sde_wb: qcom,wb-display@0 {
				phandle = <0x15>;
				status = "disabled";
				label = "wb_display";
				cell-index = <0x00>;
				compatible = "qcom,wb-display";
			};

			disp_rdump_memory: disp_rdump_region@e1000000 {
				phandle = <0x35>;
				label = "disp_rdump_region";
				reg = <0xb8000000 0x800000>;
			};
		};
	};

	fragment@52 {
		target = <&reserved_memory>;

		__overlay__ {

			splash_memory: splash_region {
				phandle = <0x36>;
				label = "cont_splash_region";
				reg = <0x00 0xb8000000 0x00 0x2b00000>;
			};

			demura_memory_0: demura_region_0 {
				phandle = <0x37>;
				label = "demura hfc region 0";
				reg = <0x00 0x00 0x00 0x00>;
			};

			demura_memory_1: demura_region_1 {
				phandle = <0x38>;
				label = "demura hfc region 1";
				reg = <0x00 0x00 0x00 0x00>;
			};
		};
	};

	fragment@53 {
		target = <&mdss_mdp>;

		__overlay__ {
			connectors = <&sde_dsi>, <&sde_dsi1>, <&smmu_sde_unsec>, <&smmu_sde_sec>, <&sde_wb>, <&sde_dp>, <&sde_rscc>;
		};
	};

