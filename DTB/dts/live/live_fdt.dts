		qcom,pmic_glink {
			compatible = "qcom,pmic-glink";
			qcom,pmic-glink-channel = "PMIC_RTR_ADSP_APPS";
			qcom,subsys-name = "lpass";
			qcom,protection-domain = "tms/servreg", "msm/adsp/charger_pd";
			depends-on-supply = <0x8c>;

			battery_charger: qcom,battery_charger {
				compatible = "qcom,battery-charger";
				phandle = <0x33b>;
				qcom,thermal-mitigation = <0xaf79e0 0xa7d8c0 0xa037a0 0x989680 0x90f560 0x895440 0x81b320 0x7a1200 0x7270e0 0x6acfc0 0x632ea0 0x5b8d80 0x53ec60 0x4c4b40 0x44aa20 0x3d0900 0x3567e0 0x2dc6c0 0x2625a0 0x1e8480 0x16e360 0xf4240 0x7a120>;
				qcom,wireless-fw-name = "idt9415.bin";
				vivo,ex-fg-psy-name = "bq_bms";
				vivo,use-cms-batt-thermal;
				vivo,soc-decimal-enable;
				vivo,equalizing-chg-tbat-limit = <0x1c2>;
				vivo,equalizing-chg-tboard-limit = <0x1c2>;
			};

			ucsi: qcom,ucsi {
