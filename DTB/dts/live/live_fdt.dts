			reg-names = "cc_base";
			vdd_mm-supply = <0x22>;
			vdd_mxa-supply = <0x1f>;
			vdd_mxc-supply = <0x23>;
			clocks = <0x20 0x00 0x21 0x24 0x0f>;
			clock-names = "bi_tcxo", "sleep_clk", "iface";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x27>;
		};

		clock_dispcc: clock-controller@af00000 {
			compatible = "qcom,cape-dispcc", "syscon";
