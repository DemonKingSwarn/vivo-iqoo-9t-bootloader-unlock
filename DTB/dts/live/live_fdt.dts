				qcom,amoled {
					compatible = "qcom,qpnp-amoled-regulator";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x5c6>;

					oledb@fa00 {
						reg = <0xfa00>;
