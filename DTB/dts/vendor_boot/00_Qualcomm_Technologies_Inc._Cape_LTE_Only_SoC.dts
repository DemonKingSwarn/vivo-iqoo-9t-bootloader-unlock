			qcom,ea-pc = <0x450>;
			dmas = <0x3a 0x03 0x3a 0x04>;
			dma-names = "rx", "tx";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			phandle = <0x27c>;

			ngd@1 {
				reg = <0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				slimbus: btfmslim-driver {
					compatible = "slim217,221";
					reg = <0x01 0x00>;
					phandle = <0x27d>;
				};
			};
		};

