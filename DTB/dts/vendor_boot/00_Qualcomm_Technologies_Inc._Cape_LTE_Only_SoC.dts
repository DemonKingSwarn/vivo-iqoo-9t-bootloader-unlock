/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Cape LTE Only SoC";
	compatible = "qcom,cape-v2";
	qcom,msm-id = <0x21c 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;

	chosen: chosen {
		bootargs = "console=null earlycon=null  kpti=0 log_buf_len=256K kernel.panic_on_rcu_stall=1 disable_dma32=on swiotlb=noforce loop.max_part=7 cgroup.memory=nokmem,nosocket pcie_ports=compat msm_rtb.filter=0x237 allow_mismatched_32bit_el0 kasan=off rcupdate.rcu_expedited=1 rcu_nocbs=0-7 ftrace_dump_on_oops pstore.compress=none cpufreq.default_governor=performance can.stats_timer=0 fsa4480_i2c.async_probe=1 slub_debug=-";
		stdout-path = "/soc/qcom,qup_uart@99c000:115200n8";
		phandle = <0x250>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	ddr-regions {
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x251>;

		hyp_mem: hyp_region@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0x600000>;
			phandle = <0x252>;
		};

		xbl_dtlog_mem: xbl_dtlog_region@80600000 {
			no-map;
			reg = <0x00 0x80600000 0x00 0x40000>;
			phandle = <0x253>;
		};

		xbl_ramdump_mem: xbl_ramdump_region@80640000 {
			no-map;
			reg = <0x00 0x80640000 0x00 0x1c0000>;
			phandle = <0x254>;
		};

		aop_image_mem: aop_image_region@80800000 {
			no-map;
			reg = <0x00 0x80800000 0x00 0x60000>;
			phandle = <0x255>;
		};

		aop_cmd_db_mem: aop_cmd_db_region@80860000 {
			compatible = "qcom,cmd-db";
			no-map;
			reg = <0x00 0x80860000 0x00 0x20000>;
			phandle = <0x256>;
		};

		aop_config_mem: aop_config_region@80880000 {
			no-map;
			reg = <0x00 0x80880000 0x00 0x20000>;
			phandle = <0x257>;
		};

		tme_crash_dump_mem: tme_crash_dump_region@808a0000 {
			no-map;
			reg = <0x00 0x808a0000 0x00 0x40000>;
			phandle = <0x258>;
		};

		tme_log_mem: tme_log_region@808e0000 {
			no-map;
			reg = <0x00 0x808e0000 0x00 0x4000>;
			phandle = <0x259>;
		};

		uefi_log_mem: uefi_log_region@808e4000 {
			no-map;
			reg = <0x00 0x808e4000 0x00 0x10000>;
			phandle = <0x25a>;
		};

		smem_mem: smem_region@80900000 {
			no-map;
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0xa8>;
		};

		cpucp_fw_mem: cpucp_fw_region@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
			phandle = <0x25b>;
		};

		cdsp_secure_heap_mem: cdsp_secure_heap_region@80c00000 {
			no-map;
			phandle = <0x25c>;
		};

		adsp_mem: adsp_region@85700000 {
			no-map;
			reg = <0x00 0x85700000 0x00 0x2800000>;
			phandle = <0x92>;
		};

		slpi_mem: slpi_region@88000000 {
			no-map;
			reg = <0x00 0x88000000 0x00 0x1900000>;
			phandle = <0xad>;
		};

		cdsp_mem: cdsp_region@89900000 {
			no-map;
			reg = <0x00 0x89900000 0x00 0x2000000>;
			phandle = <0x95>;
		};

		ipa_fw_mem: ipa_fw_region@8b900000 {
			no-map;
			reg = <0x00 0x8b900000 0x00 0x10000>;
			phandle = <0x25d>;
		};

		ipa_gsi_mem: ipa_gsi_region@8b910000 {
			no-map;
			reg = <0x00 0x8b910000 0x00 0xa000>;
			phandle = <0xb1>;
		};

		gpu_microcode_mem: gpu_microcode_region@8b91a000 {
			no-map;
			reg = <0x00 0x8b91a000 0x00 0x2000>;
			phandle = <0x22c>;
		};

		spss_region_mem: spss_region_region@8ba00000 {
			no-map;
			reg = <0x00 0x8ba00000 0x00 0x180000>;
			phandle = <0x9d>;
		};

		spu_tz_shared_mem: spu_tz_shared_mem@8bb80000 {
			no-map;
			reg = <0x00 0x8bb80000 0x00 0x60000>;
			phandle = <0x228>;
		};

		spu_modem_shared_mem: spu_modem_shared_mem@8bbe0000 {
			no-map;
			reg = <0x00 0x8bbe0000 0x00 0x20000>;
			phandle = <0x227>;
		};

		mpss_mem: mpss_region@8bc00000 {
			no-map;
			reg = <0x00 0x8bc00000 0x00 0x13200000>;
			phandle = <0x9a>;
		};

		cvp_mem: cvp_region@9ee00000 {
			no-map;
			reg = <0x00 0x9ee00000 0x00 0x700000>;
			phandle = <0x24e>;
		};

		camera_mem: camera_region@9f500000 {
			no-map;
			reg = <0x00 0x9f500000 0x00 0x800000>;
			phandle = <0x25e>;
		};

		video_mem: video_region@9fd00000 {
			no-map;
			reg = <0x00 0x9fd00000 0x00 0x700000>;
			phandle = <0x25f>;
		};

		xbl_sc_mem: xbl_sc_region@a6e00000 {
			no-map;
			reg = <0x00 0xa6e00000 0x00 0x40000>;
			phandle = <0x260>;
		};

		global_sync_mem: global_sync_region@a6f00000 {
			no-map;
			reg = <0x00 0xa6f00000 0x00 0x100000>;
			phandle = <0x261>;
		};

		qheebsp_reserved_mem: qheebsp_reserved_region@e0000000 {
			no-map;
			phandle = <0x262>;
		};

		cpusys_vm_mem: cpusys_vm_region@e0600000 {
			no-map;
			reg = <0x00 0xe0600000 0x00 0x400000>;
			phandle = <0xb5>;
		};

		hyp_reserved_mem: hyp_reserved_region@e0a00000 {
			no-map;
			phandle = <0x263>;
		};

		trust_ui_vm_mem: trust_ui_vm_region@e0b00000 {
			no-map;
			phandle = <0xb4>;
		};

		trust_ui_vm_qrtr: trust_ui_vm_qrtr@e55f3000 {
			no-map;
			phandle = <0x264>;
		};

		trust_ui_vm_vblk0_ring: trust_ui_vm_vblk0_ring@e55fc000 {
			no-map;
			gunyah-label = <0x11>;
			phandle = <0x265>;
		};

		trust_ui_vm_swiotlb: trust_ui_vm_swiotlb@e5600000 {
			no-map;
			gunyah-label = <0x12>;
			phandle = <0x266>;
		};

		tz_stat_mem: tz_stat_region@e8800000 {
			no-map;
			reg = <0x00 0xe8800000 0x00 0x100000>;
			phandle = <0x267>;
		};

		tags_mem: tags_region@e8900000 {
			no-map;
			reg = <0x00 0xe8900000 0x00 0x1200000>;
			phandle = <0x268>;
		};

		qtee_mem: qtee_region@e9b00000 {
			no-map;
			reg = <0x00 0xe9b00000 0x00 0x500000>;
			phandle = <0x269>;
		};

		sp_mem: sp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x226>;
		};

		system_cma: linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
			phandle = <0x223>;
		};

		va_md_mem: va_md_mem_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x01 0x00 0xfffffffe 0xffffffff>;
			reusable;
			size = <0x00 0x1000000>;
			phandle = <0xa6>;
		};

		user_contig_mem: user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x56>;
		};

		qseecom_mem: qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			phandle = <0x54>;
		};

		non_secure_display_memory: non_secure_display_region {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			size = <0x00 0xa400000>;
			alignment = <0x00 0x400000>;
			phandle = <0x229>;
		};

		demura_heap_memory: demura_heap_region {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x01 0x00 0xfffffffe 0xffffffff>;
			size = <0x00 0x2800000>;
			alignment = <0x00 0x400000>;
			phandle = <0x22a>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			phandle = <0x55>;
		};

		cnss_wlan_mem: cnss_wlan_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			phandle = <0x240>;
		};

		audio_cma_mem: audio_cma_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
			phandle = <0x22b>;
		};

		adsp_mem_heap: adsp_heap_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
			phandle = <0xb7>;
		};

		sdsp_mem: sdsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2800000>;
			phandle = <0x225>;
		};

		cdsp_eva_mem: cdsp_eva_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x400000>;
			phandle = <0x24f>;
		};

		ramoops_mem: ramoops_region {
			compatible = "ramoops";
			alloc-ranges = <0x00 0x00 0xffffffff 0xffffffff>;
			size = <0x00 0x200000>;
			pmsg-size = <0x200000>;
			mem-type = <0x02>;
			phandle = <0x26a>;
		};

		dump_mem: mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x01 0x00 0xfffffffe 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2c00000>;
			phandle = <0x221>;
		};
	};

	aliases: aliases {
		swr3 = "/soc/spf_core_platform/lpass-cdc/wsa2-macro@31E0000/wsa2_swr_master";
		swr2 = "/soc/spf_core_platform/lpass-cdc/va-macro@33F0000/va_swr_master";
		swr1 = "/soc/spf_core_platform/lpass-cdc/rx-macro@3200000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/lpass-cdc/wsa-macro@3240000/wsa_swr_master";
		serial0 = "/soc/qcom,qup_uart@99c000";
		hsuart0 = "/soc/qcom,qup_uart@894000";
		hsuart4 = "/soc/qcom,qup_uart@a98000";
		ufshc1 = "/soc/ufshc@1d84000";
		mmc1 = "/soc/sdhci@8804000";
		phandle = <0x26b>;
	};

	sram: sram@17D09400 {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "mmio-sram";
		reg = <0x00 0x17d09400 0x00 0x400>;
		ranges = <0x00 0x00 0x00 0x17d09400 0x00 0x400>;
		phandle = <0x26c>;

		cpu_scp_lpri: scp-shmem@0 {
			compatible = "arm,scp-shmem";
			reg = <0x00 0x00 0x00 0x400>;
			phandle = <0x8f>;
		};
	};

	firmware: firmware {
		phandle = <0x26d>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x02 0x13000>;
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};

		qcom_smcinvoke {
			compatible = "qcom,smcinvoke";
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery,vendor_boot";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/1d84000.ufshc/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "ok";
				};
			};
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			enable-method = "psci";
			next-level-cache = <0x03>;
			cpu-idle-states = <0x04>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			power-domains = <0x05>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x00 0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x15>;

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x03>;

				L3_0: l3-cache {
					compatible = "arm,arch-cache";
					cache-level = <0x03>;
					phandle = <0x07>;
				};
			};
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			next-level-cache = <0x03>;
			cpu-idle-states = <0x04>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x00 0x04>;
			phandle = <0x16>;
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			cpu-idle-states = <0x04>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x00 0x04>;
			phandle = <0x17>;

			L2_2: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x09>;
			};
		};

		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			cpu-idle-states = <0x04>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			power-domains = <0x0b>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x00 0x04>;
			phandle = <0x18>;
		};

		CPU4: cpu@400 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x400>;
			enable-method = "psci";
			next-level-cache = <0x0c>;
			cpu-idle-states = <0x0d>;
			capacity-dmips-mhz = <0x8cd>;
			dynamic-power-coefficient = <0x101>;
			power-domains = <0x0e>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x01 0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x19>;

			L2_4: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x0c>;
			};
		};

		CPU5: cpu@500 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x500>;
			enable-method = "psci";
			next-level-cache = <0x0f>;
			cpu-idle-states = <0x0d>;
			capacity-dmips-mhz = <0x8cd>;
			dynamic-power-coefficient = <0x101>;
			power-domains = <0x10>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x01 0x04>;
			phandle = <0x1a>;

			L2_5: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x0f>;
			};
		};

		CPU6: cpu@600 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x600>;
			enable-method = "psci";
			next-level-cache = <0x11>;
			cpu-idle-states = <0x0d>;
			capacity-dmips-mhz = <0x8cd>;
			dynamic-power-coefficient = <0x101>;
			power-domains = <0x12>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x01 0x04>;
			phandle = <0x1b>;

			L2_6: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x11>;
			};
		};

		CPU7: cpu@700 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x700>;
			enable-method = "psci";
			next-level-cache = <0x13>;
			cpu-idle-states = <0x0d>;
			capacity-dmips-mhz = <0x952>;
			dynamic-power-coefficient = <0x1fd>;
			power-domains = <0x14>;
			power-domain-names = "psci";
			qcom,freq-domain = <0x06 0x02 0x04>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			L2_7: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				next-level-cache = <0x07>;
				phandle = <0x13>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x16>;
				};

				core2 {
					cpu = <0x17>;
				};

				core3 {
					cpu = <0x18>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x19>;
				};

				core1 {
					cpu = <0x1a>;
				};

				core2 {
					cpu = <0x1b>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x1c>;
				};
			};
		};
	};

	idle-states {

		SILVER_OFF: silver-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <0x320>;
			exit-latency-us = <0x2ee>;
			min-residency-us = <0xffa>;
			arm,psci-suspend-param = <0x40000004>;
			local-timer-stop;
			phandle = <0x04>;
		};

		GOLD_OFF: gold-c4 {
			compatible = "arm,idle-state";
			idle-state-name = "rail-pc";
			entry-latency-us = <0x258>;
			exit-latency-us = <0x60e>;
			min-residency-us = <0x12b7>;
			arm,psci-suspend-param = <0x40000004>;
			local-timer-stop;
			phandle = <0x0d>;
		};

		CLUSTER_PWR_DN: cluster-d4 {
			compatible = "domain-idle-state";
			idle-state-name = "l3-off";
			entry-latency-us = <0x41a>;
			exit-latency-us = <0x9c4>;
			min-residency-us = <0x14bd>;
			arm,psci-suspend-param = <0x41000044>;
			phandle = <0x38>;
		};

		APSS_OFF: cluster-e3 {
			compatible = "domain-idle-state";
			idle-state-name = "llcc-off";
			entry-latency-us = <0xa8c>;
			exit-latency-us = <0xdac>;
			min-residency-us = <0x3687>;
			arm,psci-suspend-param = <0x4100c344>;
			phandle = <0x39>;
		};
	};

	cluster-device {
		compatible = "qcom,lpm-cluster-dev";
		power-domains = <0x1d>;
	};

	soc: soc {
		interrupt-parent = <0x01>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x26e>;

		clocks {

			xo_board: xo_board {
				compatible = "fixed-clock";
				clock-frequency = <0x493e000>;
				clock-output-names = "xo_board";
				#clock-cells = <0x00>;
				phandle = <0x26f>;
			};

			sleep_clk: sleep_clk {
				compatible = "fixed-clock";
				clock-frequency = <0x7d00>;
				clock-output-names = "sleep_clk";
				#clock-cells = <0x00>;
				phandle = <0x21>;
			};
		};

		clock_gcc: clock-controller@100000 {
			compatible = "qcom,cape-gcc", "syscon";
			reg = <0x100000 0x1f4200>;
			reg-names = "cc_base";
			vdd_cx-supply = <0x1e>;
			vdd_mxa-supply = <0x1f>;
			clocks = <0x20 0x00 0x21>;
			clock-names = "bi_tcxo", "sleep_clk";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x24>;
		};

		clock_videocc: clock-controller@aaf0000 {
			compatible = "qcom,cape-videocc", "syscon";
