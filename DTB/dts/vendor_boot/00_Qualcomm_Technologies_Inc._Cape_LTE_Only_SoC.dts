					pins = "gpio119";
				};

				config {
					output-low;
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio119";
				};
			};

			cam_sensor_active_rst5: cam_sensor_active_rst5 {
				phandle = <0x482>;

				mux {
					function = "gpio";
					pins = "gpio118";
				};

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio118";
				};
			};

